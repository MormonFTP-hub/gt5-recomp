+static DWORD WINAPI adec_worker_thread(LPVOID arg)
+{
+    ps3_thread_name("cellAdec %u", (u32)(uintptr_t)arg);
+    ps3_thread_on_fast_cores();   /* a block is due every 43 ms */
+    adec_worker_loop((CellAdecHandle)(uintptr_t)arg);
+    return 0;
+}
+#else
+static void* adec_worker_thread(void* arg)
+{
+    adec_worker_loop((CellAdecHandle)(uintptr_t)arg);
+    return NULL;
+}
+#endif
