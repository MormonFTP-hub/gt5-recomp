+static void worker_step(unsigned long long* next_attach_us, unsigned long long* last_in_us,
+                        u8* last_report, int* have_last)
+{
+    WheelInput in;
+    const int conn = wheel_host_read(&in);
+    const unsigned long long now = usbd_now_us();
+
+    usbd_lock(&s_lock);
+    const int attached = s_attached, present = s_present, have_ldd = s_ldd_count > 0;
+    usbd_unlock(&s_lock);
+    if (conn && !present && have_ldd && now >= *next_attach_us) {
+        *next_attach_us = now + 3000000ull;   /* if it fails, try again in a while */
+        try_attach();
+        *have_last = 0;
+        return;
+    }
+    if (!conn && attached) { do_detach(); return; }
+    if (!present) return;
+
+    /* Control and OUT transfers, in order. The lock is never held across a
+     * call into the game: its callbacks queue the next transfer. */
+    for (;;) {
+        UsbdXfer x;
+        usbd_lock(&s_lock);
+        if (!s_q_n) { usbd_unlock(&s_lock); break; }
+        x = s_q[s_q_head];
+        s_q_head = (s_q_head + 1) % QCAP;
+        s_q_n--;
+        usbd_unlock(&s_lock);
+        if (x.ep == 0) {
+            s32 count = 0;
+            const s32 res = do_control(&x, &count);
+            complete(&x, res, count);
+        } else {
+            u8 data[64];
+            const u32 len = (u32)(x.len < 0 ? 0 : (x.len > 64 ? 64 : x.len));
+            if (x.buf && len) { vm_memcpy_from(data, x.buf, len); wheel_g27_output(data, len); }
+            complete(&x, CELL_USBD_HC_CC_NOERR, x.len);
+        }
+    }
+
+    /* IN reads: a new report as soon as it changes (2 ms apart at most, the
+     * G27's polling interval), and the same one again every 8 ms. */
+    u8 rep[USBD_REPORT_LEN];
+    wheel_g27_report(&in, rep);
+    const int changed = !*have_last || memcmp(rep, last_report, USBD_REPORT_LEN) != 0;
+    const unsigned long long since = now - *last_in_us;
+    if (!((changed && since >= 2000) || since >= 8000)) return;
+    UsbdXfer x;
+    usbd_lock(&s_lock);
+    if (!s_in_n) { usbd_unlock(&s_lock); return; }
+    x = s_in[0];
+    memmove(&s_in[0], &s_in[1], (size_t)(s_in_n - 1) * sizeof s_in[0]);
+    s_in_n--;
+    usbd_unlock(&s_lock);
+    s32 n = x.len < USBD_REPORT_LEN ? x.len : USBD_REPORT_LEN;
+    if (n < 0) n = 0;
+    if (x.buf && n) vm_memcpy_to(x.buf, rep, (size_t)n);
+    memcpy(last_report, rep, USBD_REPORT_LEN);
+    *have_last = 1;
+    *last_in_us = now;
+    if (trace()) {
+        static unsigned lines;
+        if (lines++ < 40)
+            fprintf(stderr, "[cellUsbd] report %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X %02X\n",
+                    rep[0], rep[1], rep[2], rep[3], rep[4], rep[5], rep[6], rep[7], rep[8], rep[9], rep[10]);
+    }
+    complete(&x, CELL_USBD_HC_CC_NOERR, n);
+}
+
+#ifdef _WIN32
+static DWORD WINAPI usbd_worker(LPVOID unused)
+#else
+static void* usbd_worker(void* unused)
+#endif
+{
+    (void)unused;
+    unsigned long long next_attach = 0, last_in = 0;
+    u8 last_report[USBD_REPORT_LEN];
+    int have_last = 0;
+    while (!s_stop) {
+        worker_step(&next_attach, &last_in, last_report, &have_last);
+        usbd_sleep_ms(s_present ? 1 : 20);
+    }
+    return 0;
