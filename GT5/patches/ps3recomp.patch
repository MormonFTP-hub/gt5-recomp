+/* GCM_DRAIN_STAT=1: where a present's time goes: before the flush (copies, dumps), the flush (the
+ * GPU finishing the frame), and the swap chain's Present. LD_PRESENT_SYNC=0 presents without
+ * waiting for vblank. */
+static LONGLONG lps_now(void) { LARGE_INTEGER t; QueryPerformanceCounter(&t); return t.QuadPart; }
+static UINT lps_sync_interval(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("LD_PRESENT_SYNC"); v = e ? atoi(e) : 1; }
+    return (UINT)v;
+}
+static void lps_note(LONGLONG t0, LONGLONG t1, LONGLONG t2, LONGLONG t3)
+{
+    static int on = -1;
+    if (on < 0) on = getenv("GCM_DRAIN_STAT") ? 1 : 0;
+    if (!on) return;
+    static LONGLONG pre, flush, swap, last;
+    static unsigned n;
+    pre += t1 - t0; flush += t2 - t1; swap += t3 - t2; n++;
+    LARGE_INTEGER f;
+    QueryPerformanceFrequency(&f);
+    if (!last) last = t3;
+    if (t3 - last >= 5 * f.QuadPart) {
+        const double k = 1000.0 / f.QuadPart / n;
+        extern unsigned g_ld_ovl_why_pub[8];
+        fprintf(stderr, "[present-parts] %u presents: before flush %.1f ms, flush %.1f ms, Present %.1f ms | no overlap: reads %u upload %u vb %u ib %u cb %u pscb %u srv %u smp %u\n",
+                n, pre * k, flush * k, swap * k, g_ld_ovl_why_pub[0], g_ld_ovl_why_pub[1], g_ld_ovl_why_pub[2],
+                g_ld_ovl_why_pub[3], g_ld_ovl_why_pub[4], g_ld_ovl_why_pub[5], g_ld_ovl_why_pub[6], g_ld_ovl_why_pub[7]);
+        memset(g_ld_ovl_why_pub, 0, sizeof g_ld_ovl_why_pub);
+        { extern LONGLONG g_vx_pub[3]; extern unsigned long long g_vx_pub_n[2];
+          fprintf(stderr, "[vertex-time] per present: gather indices %.2f ms, de-duplicate %.2f ms, convert %.2f ms; %llu vertices, %llu of them in parallel\n",
+                  g_vx_pub[0] * k, g_vx_pub[1] * k, g_vx_pub[2] * k, g_vx_pub_n[0] / (n ? n : 1), g_vx_pub_n[1] / (n ? n : 1));
+          g_vx_pub[0] = g_vx_pub[1] = g_vx_pub[2] = 0; g_vx_pub_n[0] = g_vx_pub_n[1] = 0; }
+        { extern unsigned long long g_vc_stat[8];
+          const double per = 1.0 / (n ? n : 1);
+          fprintf(stderr, "[vcache] per present: %.0f drawn from cache, %.0f stored, %.0f new, %.0f rewritten, %.0f left alone, %.0f not cacheable; %.0f failed, %llu wipes\n",
+                  g_vc_stat[0] * per, g_vc_stat[1] * per, g_vc_stat[2] * per, g_vc_stat[3] * per, g_vc_stat[4] * per,
+                  g_vc_stat[5] * per, g_vc_stat[7] * per, g_vc_stat[6]);
+          { extern unsigned long long g_tex_page_skip_pub, g_tex_page_look_pub;
+            fprintf(stderr, "[texpages] per present: %.0f texture checks, %.0f skipped the hash (pages unwritten)\n",
+                    g_tex_page_look_pub * per, g_tex_page_skip_pub * per);
+            g_tex_page_skip_pub = g_tex_page_look_pub = 0; }
+          { extern unsigned long long g_vc_why[6];
+            if (g_vc_stat[7]) fprintf(stderr, "[vcache] failures: index %llu, attribute %llu, none %llu, spread %llu, reset %llu, query %llu\n",
+                                      g_vc_why[0], g_vc_why[1], g_vc_why[2], g_vc_why[3], g_vc_why[4], g_vc_why[5]); }
+          for (int q = 0; q < 8; q++) if (q != 6) g_vc_stat[q] = 0; }
+        { extern LONGLONG g_dt_pub[6]; extern unsigned long long g_dt_draws;
+          extern void cellGcm_frame_counters(unsigned long long* walk_us, unsigned long long* wait_us);
+          static unsigned long long w0, i0; unsigned long long w, i; cellGcm_frame_counters(&w, &i);
+          fprintf(stderr, "[draw-time] per present: %llu draws; vertices %.2f, setup %.2f, pipeline %.2f, surfaces+textures %.2f, record %.2f ms; draws in all %.2f ms; whole walk %.2f ms\n",
+                  g_dt_draws / (n ? n : 1), g_dt_pub[0] * k, g_dt_pub[1] * k, g_dt_pub[2] * k, g_dt_pub[3] * k, g_dt_pub[4] * k,
+                  g_dt_pub[5] * k, (double)(w - w0) / 1000.0 / (n ? n : 1));
+          w0 = w; i0 = i; (void)i0;
+          for (int q = 0; q < 6; q++) g_dt_pub[q] = 0;
+          g_dt_draws = 0; }
+        { extern unsigned long long g_pso_tsc[6], g_pso_n, g_pso_fpm;
+          unsigned long long tot = 0;
+          for (int q = 0; q < 6; q++) tot += g_pso_tsc[q];
+          if (g_pso_n && tot)
+              fprintf(stderr, "[pso-time] %llu lookups found a pipeline, %.0f%% with the fragment program memoised, %u pipelines so far; "
+                              "split: vertex program %.0f%%, fragment program %.0f%%, textures %.0f%%, constants %.0f%%, key %.0f%%, table %.0f%%\n",
+                      g_pso_n, 100.0 * (double)g_pso_fpm / (double)g_pso_n, g.n_psos,
+                      100.0 * g_pso_tsc[0] / tot, 100.0 * g_pso_tsc[1] / tot, 100.0 * g_pso_tsc[2] / tot,
+                      100.0 * g_pso_tsc[3] / tot, 100.0 * g_pso_tsc[4] / tot, 100.0 * g_pso_tsc[5] / tot);
+          memset(g_pso_tsc, 0, sizeof g_pso_tsc);
+          g_pso_n = g_pso_fpm = 0; }
+        { extern unsigned long long g_keycheck[3];
+          if (g_keycheck[0])
+              fprintf(stderr, "[pso-keycheck] %llu draws checked: %llu merged two chain keys (must be 0), %llu split one\n",
+                      g_keycheck[0], g_keycheck[1], g_keycheck[2]); }
+        { extern unsigned long long g_bt_tsc[3];
+          /* rdtsc ticks to milliseconds, from the TSC's rate against QPC since the first report. */
+          static unsigned long long tsc0; static LONGLONG qpc0;
+          const unsigned long long tsc_now = __rdtsc();
+          if (!tsc0) { tsc0 = tsc_now; qpc0 = t3; }
+          const double tick_ms = (t3 > qpc0 && tsc_now > tsc0)
+              ? (double)(t3 - qpc0) * 1000.0 / (double)f.QuadPart / (double)(tsc_now - tsc0) : 0.0;
+          const double per = tick_ms / (n ? n : 1);
+          const unsigned long long bt = g_bt_tsc[0] + g_bt_tsc[1] + g_bt_tsc[2];
+          { extern unsigned long long g_tex_neg[2];
+            if (bt && tick_ms > 0.0)
+              fprintf(stderr, "[bind-time] surfaces+textures per present: before the fragment textures %.2f ms, binding them %.2f ms, vertex textures and targets %.2f ms; "
+                              "plain textures known %.0f, learned %.0f\n",
+                      g_bt_tsc[0] * per, g_bt_tsc[1] * per, g_bt_tsc[2] * per,
+                      (double)g_tex_neg[0] / (n ? n : 1), (double)g_tex_neg[1] / (n ? n : 1));
+            g_tex_neg[0] = g_tex_neg[1] = 0; }
+          memset(g_bt_tsc, 0, sizeof g_bt_tsc); }
+        { extern unsigned long long g_cb_dedup[2];
+          if (g_cb_dedup[0] + g_cb_dedup[1])
+              fprintf(stderr, "[vconst] per present: %.0f constant blocks uploaded, %.0f draws reused the one before\n",
+                      (double)g_cb_dedup[1] / (n ? n : 1), (double)g_cb_dedup[0] / (n ? n : 1));
+          g_cb_dedup[0] = g_cb_dedup[1] = 0; }
+        { extern unsigned long long g_rec_ops, g_rec_sync_qpc;
+          if (g_rec_ops)
+              fprintf(stderr, "[ld-rec] per present: %.0f calls recorded on the second thread, walker waited %.2f ms for it\n",
+                      (double)g_rec_ops / (n ? n : 1), (double)g_rec_sync_qpc * k);
+          g_rec_ops = g_rec_sync_qpc = 0; }
+        pre = flush = swap = 0; n = 0; last = t3;
+    }
+}
