+static void ds_parse(const u8* b, DWORD n, int dualsense)
+{
+    /* Where the sticks and buttons sit in this report. */
+    u32 st, tr, bt;
+    /* Windows hands back every report at the device's longest length: 64 bytes on USB, 78 on Bluetooth.
+     * A Bluetooth pad nobody has switched to full reports (Steam does) sends the simple 0x01 at 78, and
+     * taken for USB its triggers read as buttons and its face buttons as trigger pressure. */
+    if (dualsense && b[0] == 0x01 && n >= 11 + 40 && n <= 64) { st = 1; tr = 5; bt = 8; }   /* USB */
+    else if (dualsense && b[0] == 0x31 && n >= 12) { st = 2; tr = 6; bt = 9; }          /* Bluetooth, full */
+    else if (b[0] == 0x01 && n >= 10) { st = 1; tr = 8; bt = 5; }                       /* DS4 USB, Bluetooth simple */
+    else if (!dualsense && b[0] == 0x11 && n >= 12) { st = 3; tr = 10; bt = 7; }        /* DS4 Bluetooth, full */
+    else return;
+    const u8 b0 = b[bt], b1 = b[bt + 1];
+    u16 btns = 0;
+    static const u16 hat[8] = {
+        CELL_PAD_CTRL_UP, CELL_PAD_CTRL_UP | CELL_PAD_CTRL_RIGHT, CELL_PAD_CTRL_RIGHT,
+        CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_RIGHT, CELL_PAD_CTRL_DOWN, CELL_PAD_CTRL_DOWN | CELL_PAD_CTRL_LEFT,
+        CELL_PAD_CTRL_LEFT, CELL_PAD_CTRL_UP | CELL_PAD_CTRL_LEFT };
+    if ((b0 & 0xF) < 8) btns |= hat[b0 & 0xF];
+    if (b0 & 0x10) btns |= CELL_PAD_CTRL_SQUARE;
+    if (b0 & 0x20) btns |= CELL_PAD_CTRL_CROSS;
+    if (b0 & 0x40) btns |= CELL_PAD_CTRL_CIRCLE;
+    if (b0 & 0x80) btns |= CELL_PAD_CTRL_TRIANGLE;
+    if (b1 & 0x01) btns |= CELL_PAD_CTRL_L1;
