+    for (u32 i = 0; i < n; i++) {
+        if (m && lo[i] <= hi[m - 1] + 16384) { if (hi[i] > hi[m - 1]) hi[m - 1] = hi[i]; continue; }
+        lo[m] = lo[i]; hi[m] = hi[i]; m++;
+    }
+    if (m > LD_VC_SPANS) {                                       /* one span over all of it, if small */
