+     * (libgcm's SetVertexProgramConstants: CONST_ID, then up to 32 words into
+     * 0x1F00..0x1F7C as one incrementing run). The part of a run inside it is
+     * stored at once -- the register file, its write counts and the constants,
+     * exactly what rsx_dispatch_method does for each of those words. The
+     * traces that watch these words take the word-by-word path. */
+    static int traced = -1;
+    if (traced < 0) traced = (getenv("RSX_GROUP_TRACE") || getenv("RSX_CONST_LOG")) ? 1 : 0;
+    u32 i = 0;
+    while (i < count) {
+        const u32 m = (incrementing ? method + 4u * i : method) & 0xFFFFCu;
+        if (incrementing && !traced && m >= M_VP_UPLOAD_CONST && m < M_VP_UPLOAD_CONST + 32u * 4u) {
+            u32 n = (M_VP_UPLOAD_CONST + 32u * 4u - m) >> 2;
+            if (n > count - i) n = count - i;
+            const u32 slot0 = rsx->regs[M_VP_UPLOAD_CONST_ID >> 2];
+            const u32 word0 = (m - M_VP_UPLOAD_CONST) >> 2;
+            const u32 idx0 = m >> 2;
+            for (u32 k = 0; k < n; k++) {
+                const u32 v = dsp_be32(be + 4u * (i + k));
+                const u32 word = word0 + k;
+                const u32 slot = slot0 + (word >> 2);
+                rsx->seen[idx0 + k]++;
+                rsx->regs[idx0 + k] = v;
+                if (slot < RSX_DSP_NUM_CONSTANTS)
+                    rsx->constants[slot][word & 3] = v;
+            }
+            rsx->const_gen++;
+            i += n;
+            continue;
+        }
+        rsx_dispatch_method(rsx, m, dsp_be32(be + 4u * i));
+        i++;
+    }
+}
