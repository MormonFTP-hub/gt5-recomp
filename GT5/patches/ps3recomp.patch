+/* The whole shader cache in memory, so a race never opens a file. One cached shader cost about 7 ms
+ * to open even on an SSD (10,000 small files; scanning on open, most likely), and a new track wants
+ * hundreds at once: 443 reads were 3.2 s of one 4.2 s frame. A thread reads pack.bin, every entry in
+ * one file, adds any .bin files the pack doesn't have yet (8 readers), and rewrites the pack when it
+ * found some. Until it is done, loads go to the files as before. RSX_SHADER_CACHE_PRELOAD=0 off. */
+typedef struct { u64 key; const u8* data; u32 size; } shader_mem_entry;
+static shader_mem_entry* s_shader_mem;
+static u32 s_shader_mem_mask;
+static volatile LONG s_shader_mem_ready;
+#define SHADER_PACK_MAGIC 0x50535A59u /* "YZSP" */
+
+static u64 shader_mem_key(u32 stage, u64 hash, u32 source_length)
+{
+    const u64 k = hash ^ ((u64)stage << 56) ^ ((u64)source_length * 0x9E3779B97F4A7C15ull);
+    return k ? k : 1u;
+}
+static void shader_mem_put(u64 key, const u8* data, u32 size)
+{
+    u32 i = (u32)(key ^ (key >> 29)) & s_shader_mem_mask;
+    while (s_shader_mem[i].key && s_shader_mem[i].key != key) i = (i + 1u) & s_shader_mem_mask;
+    s_shader_mem[i].key = key; s_shader_mem[i].data = data; s_shader_mem[i].size = size;
+}
+static const shader_mem_entry* shader_mem_get(u64 key)
+{
+    u32 i = (u32)(key ^ (key >> 29)) & s_shader_mem_mask;
+    while (s_shader_mem[i].key) {
+        if (s_shader_mem[i].key == key) return &s_shader_mem[i];
+        i = (i + 1u) & s_shader_mem_mask;
+    }
+    return NULL;
+}
+static int shader_mem_entry_key(const u8* d, u32 size, u64* key)
+{
+    shader_disk_cache_header h;
+    if (size < sizeof h) return 0;
+    memcpy(&h, d, sizeof h);
+    if (h.magic != SHADER_DISK_CACHE_MAGIC || h.version != SHADER_DISK_CACHE_VERSION) return 0;
+    if ((u64)sizeof h + h.source_length + h.blob_length != size) return 0;
+    if (!h.blob_length || h.blob_length > SHADER_DISK_CACHE_MAX_BLOB) return 0;
+    *key = shader_mem_key(h.stage, h.source_hash, h.source_length);
+    return 1;
