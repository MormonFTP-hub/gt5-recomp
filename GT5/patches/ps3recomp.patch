+/* Arena space for a store; a full arena is emptied, after the GPU has finished with it. Returns 0
+ * (and the draw takes the ring) when the arena was just emptied or cannot be made. */
+static int ld_vc_alloc(u64 vb_bytes, u64 ib_bytes, u32* vb_off, u32* ib_off)
+{
+    if (!s_vc_buf) {
+        D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_UPLOAD;
+        D3D12_RESOURCE_DESC bd = {0};
+        bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = s_vc_size;
+        bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+        bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+        bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        if (FAILED(g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+                D3D12_RESOURCE_STATE_GENERIC_READ, NULL, &IID_ID3D12Resource, (void**)&s_vc_buf)) || !s_vc_buf) {
+            fprintf(stderr, "[vcache] cannot create the %llu MB arena; off\n", (unsigned long long)(s_vc_size >> 20));
+            s_vc_on = 0; s_vc_buf = NULL;
+            return 0;
+        }
+        D3D12_RANGE rr = {0, 0};
+        s_vc_buf->lpVtbl->Map(s_vc_buf, 0, &rr, (void**)&s_vc_mapped);
+    }
+    const u64 need = ((vb_bytes + 255u) & ~255ull) + ((ib_bytes + 255u) & ~255ull);
+    if (need > s_vc_size / 8) return 0;
+    if (s_vc_used + need > s_vc_size) {
+        ld_flush(LD_FLUSH_VERTEX_RING);   /* waits: nothing in flight reads the arena after this */
+        g.vb_used = 0; g.ib_used = 0; g.cb_used = 0; g.ps_cb_used = 0;
+        g.srv_ring_used = 0; g.smp_ring_used = 0;
+        memset(s_vc, 0, (size_t)LD_VC_SLOTS * sizeof(ld_vc_entry));
+        s_vc_used = 0;
+        g_vc_stat[6]++;
+        return 0;
+    }
+    *vb_off = (u32)s_vc_used;
+    *ib_off = (u32)(s_vc_used + ((vb_bytes + 255u) & ~255ull));
+    s_vc_used += need;
+    return 1;
+}
