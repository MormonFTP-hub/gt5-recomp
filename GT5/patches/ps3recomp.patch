+/* ---------------------------------------------------------------------------
+ * Custom controllers (LDD). The handle is the port number, as on the console.
+ * -------------------------------------------------------------------------*/
+
+s32 cellPadLddRegisterController(void)
+{
+    if (!s_pad_initialized)
+        return CELL_PAD_ERROR_NOT_OPENED;
+    int port = -1;
+    for (u32 p = PAD_MAX_HOST_PORTS; p < s_max_connect && p < CELL_PAD_MAX_PORT_NUM; p++)
+        if (!s_ldd[p].used) { port = (int)p; break; }
+    for (int p = (int)s_max_connect - 1; port < 0 && p >= 1; p--)   /* a title with few ports */
+        if (p < CELL_PAD_MAX_PORT_NUM && !s_ldd[p].used &&
+            !(p < PAD_MAX_HOST_PORTS && s_host_state[p].connected))
+            port = p;
+    if (port < 0)
+        return CELL_PAD_ERROR_TOO_MANY_DEVICES;
+    PadLdd* l = &s_ldd[port];
+    memset(l->button, 0, sizeof l->button);
+    l->button[1] = 0x70 | (CELL_PAD_LEN_CHANGE_DEFAULT / 2);
+    l->button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_X] = l->button[CELL_PAD_BTN_OFFSET_ANALOG_RIGHT_Y] = 128;
+    l->button[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_X] = l->button[CELL_PAD_BTN_OFFSET_ANALOG_LEFT_Y] = 128;
+    s_port_setting[port] = 0;
+    __atomic_store_n(&l->used, 1, __ATOMIC_RELEASE);
+    __atomic_store_n(&s_ldd_changed[port], 1, __ATOMIC_RELAXED);
+    printf("[cellPad] LddRegisterController -> port %d\n", port);
+    return port;
+}
+
+s32 cellPadLddUnregisterController(s32 handle)
+{
+    if (!s_pad_initialized)
+        return CELL_PAD_ERROR_NOT_OPENED;
+    if (handle < 0 || handle >= CELL_PAD_MAX_PORT_NUM)
+        return CELL_PAD_ERROR_INVALID_PARAMETER;
+    if (!s_ldd[handle].used)
+        return CELL_PAD_ERROR_NO_DEVICE;
+    __atomic_store_n(&s_ldd[handle].used, 0, __ATOMIC_RELEASE);
+    __atomic_store_n(&s_ldd_changed[handle], 1, __ATOMIC_RELAXED);
+    printf("[cellPad] LddUnregisterController(port %d)\n", handle);
+    return CELL_OK;
+}
+
+s32 cellPadLddDataInsert(s32 handle, CellPadData* data_guest)
+{
+    if (!s_pad_initialized)
+        return CELL_PAD_ERROR_NOT_OPENED;
+    const unsigned int ea = (unsigned int)(uintptr_t)data_guest;
+    if (handle < 0 || handle >= CELL_PAD_MAX_PORT_NUM || !ea)
+        return CELL_PAD_ERROR_INVALID_PARAMETER;
+    if (!s_ldd[handle].used)
+        return CELL_PAD_ERROR_NO_DEVICE;
+    for (int i = 0; i < CELL_PAD_MAX_CODES; i++)
+        s_ldd[handle].button[i] = vm_read16(ea + 4 + (unsigned int)i * 2);
+    return CELL_OK;
+}
+
+s32 cellPadLddGetPortNo(s32 handle)
+{
+    if (!s_pad_initialized)
+        return CELL_PAD_ERROR_NOT_OPENED;
+    if (handle < 0 || handle >= CELL_PAD_MAX_PORT_NUM || !s_ldd[handle].used)
+        return CELL_PAD_ERROR_INVALID_PARAMETER;
+    return handle;
+}
