+/* Textures: GT5 hashed every bound texture once a frame to see whether the guest had rewritten
+ * it. When none of its pages has been written since the last look, the content is the same and
+ * the hash is skipped; otherwise the pages are harvested before the hash reads them, so a write
+ * during or after the read shows next time. LD_TEX_PAGES=0 hashes as before. */
+static int ld_tex_pages_unwritten(texcache_t* entry, const rsx_dsp_texture* t)
+{
+    static int on = -1;
+    if (on < 0) { const char* v = getenv("LD_TEX_PAGES"); on = !v || atoi(v) != 0; }
+    if (!on) return 0;
+    const u32 span = texture_source_span(t);
+    const u8* src = span ? guest_ptr(t->location, t->offset, span) : NULL;
+    if (!src) { entry->wgen = 0; return 0; }
+    const u8* lo = (const u8*)((uintptr_t)src & ~(uintptr_t)4095);
+    const u8* hi = (const u8*)(((uintptr_t)src + span + 4095) & ~(uintptr_t)4095);
+    g_tex_page_look++;
+    if (!ld_vc_harvest(lo, hi)) { entry->wgen = 0; return 0; }
+    const u32 since = entry->wgen;
+    entry->wgen = s_vc_gen;     /* what the hash about to run (if any) reads is at least this new */
+    if (!since) return 0;
+    for (const u8* pg = lo; pg < hi; pg += 4096)
+        if (s_vc_page_gen[(u32)((pg - vm_base) >> 12)] > since) return 0;
+    entry->last_hash_frame = g_ld_frames;
+    g_tex_page_skip++;
+    return 1;
+}
