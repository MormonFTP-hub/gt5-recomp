+    int i = 0;
+    while (i < MEMPOOL_MAX && s_mempool[i].used) i++;
+    if (i == MEMPOOL_MAX) { slot_unlock(); free(stack); return CELL_EAGAIN; }
+    SysMempool* p = &s_mempool[i];
+    p->used = 1;
+    p->chunk = chunk;
+    p->block_size = (u32)block_size;
+    p->count = (u32)count;
+    p->free = stack;
+    /* Handed out from the start of the chunk upward. */
+    for (u32 b = 0; b < p->count; b++) p->free[b] = chunk + (p->count - 1 - b) * p->block_size;
+    p->nfree = p->count;
+    slot_unlock();
+    vm_write32(mempool_ea, (u32)(i + 1));
+    return CELL_OK;
+}
+
+s32 sys_mempool_destroy(u32 mempool)
+{
+    slot_lock();
+    SysMempool* p = mempool_get(mempool);
+    if (!p) { slot_unlock(); return CELL_ESRCH; }
+    free(p->free);
+    memset(p, 0, sizeof *p);
+    slot_unlock();
+    return CELL_OK;
+}
+
+u32 sys_mempool_try_allocate_block(u32 mempool)
+{
+    slot_lock();
+    SysMempool* p = mempool_get(mempool);
+    const u32 block = (p && p->nfree) ? p->free[--p->nfree] : 0;
+    slot_unlock();
+    return block;
+}
+
+u32 sys_mempool_allocate_block(u32 mempool)
+{
+    /* Waits for a block to be freed when the pool is empty. */
+    for (;;) {
+        if (!mempool_get(mempool)) return 0;
+        const u32 block = sys_mempool_try_allocate_block(mempool);
+        if (block) return block;
+#ifdef _WIN32
+        Sleep(1);
+#else
+        usleep(1000);
+#endif
+    }
+}
+
+s32 sys_mempool_free_block(u32 mempool, u32 block)
+{
+    slot_lock();
+    SysMempool* p = mempool_get(mempool);
+    s32 rc = CELL_OK;
+    if (!p) rc = CELL_ESRCH;
+    else if (block < p->chunk || block >= p->chunk + p->count * p->block_size ||
+             (block - p->chunk) % p->block_size != 0 || p->nfree >= p->count)
+        rc = CELL_EINVAL;
+    else p->free[p->nfree++] = block;
+    slot_unlock();
+    return rc;
+}
+
+u64 sys_mempool_get_count(u32 mempool)
+{
+    slot_lock();
+    SysMempool* p = mempool_get(mempool);
+    const u64 n = p ? (u64)(p->count - p->nfree) : 0;   /* blocks in use */
+    slot_unlock();
+    return n;
+}
