+                const ldt_draw* d = &g_ldt.d[i];
+                u32 k = 0;
+                while (k < g_ldt.n_sum && (g_ldt.sum[k].key != d->key || g_ldt.sum[k].target != d->target)) k++;
+                if (k == g_ldt.n_sum) {
+                    if (k == LDT_KEYS) continue;
+                    memset(&g_ldt.sum[k], 0, sizeof g_ldt.sum[k]);
+                    g_ldt.sum[k].key = d->key;
+                    g_ldt.sum[k].target = d->target;
+                    g_ldt.n_sum++;
+                }
+                g_ldt.sum[k].ticks += t[2 * i + 1] - t[2 * i];
+                if (i) g_ldt.sum[k].gap += t[2 * i] - t[2 * i - 1];
+                g_ldt.sum[k].n++;
+                g_ldt.sum[k].verts += d->verts;
+            }
+            D3D12_RANGE none;
+            none.Begin = none.End = 0;
+            g_ldt.rb->lpVtbl->Unmap(g_ldt.rb, 0, &none);
+        }
+        g_ldt.n = 0;
+    }
+    const ULONGLONG now = GetTickCount64();
+    if (now - g_ldt.printed_at < 5000) return;
+    g_ldt.printed_at = now;
+    const u32 flips = g_ld_frames - g_ldt.flips_at ? g_ld_frames - g_ldt.flips_at : 1;
+    g_ldt.flips_at = g_ld_frames;
+    qsort(g_ldt.sum, g_ldt.n_sum, sizeof g_ldt.sum[0], ldt_cmp);
+    const double ms = 1000.0 / (double)g_ldt.freq / flips;
+    u64 draw_t = 0, gap_t = 0, n = 0;
+    for (u32 k = 0; k < g_ldt.n_sum; k++) { draw_t += g_ldt.sum[k].ticks; gap_t += g_ldt.sum[k].gap; n += g_ldt.sum[k].n; }
+    fprintf(stderr, "[gpu-time] %u flips: %.1f ms/flip in draws, %.1f between draws, %llu draws/flip, %u shader+target pairs\n",
+            flips, draw_t * ms, gap_t * ms, (unsigned long long)(n / flips), g_ldt.n_sum);
+    for (u32 k = 0; k < g_ldt.n_sum && k < 14; k++) {
+        const ldt_sum* m = &g_ldt.sum[k];
+        const surface_t* ts = m->target < MAX_SURFACES ? &g.surfaces[m->target] : NULL;
+        fprintf(stderr, "[gpu-time]   K=%016llX draw %6.2f gap %6.2f ms/flip, %5llu draws %8llu verts, target %u:0x%07X %ux%u\n",
+                (unsigned long long)m->key, m->ticks * ms, m->gap * ms, (unsigned long long)(m->n / flips),
+                (unsigned long long)(m->verts / flips), ts ? ts->location : 0, ts ? ts->offset : 0, ts ? ts->w : 0, ts ? ts->h : 0);
+    }
+    g_ldt.n_sum = 0;
+}
