+static void ld_rec_exec(const ld_rec_hdr* h)
+{
+    ID3D12GraphicsCommandList* L = s_rec_real;
+    const ID3D12GraphicsCommandListVtbl* V = L->lpVtbl;
+    const void* p = h + 1;
+    switch (h->op) {
+    case RO_BARRIER:  { const ro_barrier* o = p; V->ResourceBarrier(L, o->n, o->b); break; }
+    case RO_COPYTEX:  { const ro_copytex* o = p; V->CopyTextureRegion(L, &o->dst, o->x, o->y, o->z, &o->src, o->has_box ? &o->box : NULL); break; }
+    case RO_GRT:      { const ro_table* o = p; V->SetGraphicsRootDescriptorTable(L, o->idx, o->h); break; }
+    case RO_CRT:      { const ro_table* o = p; V->SetComputeRootDescriptorTable(L, o->idx, o->h); break; }
+    case RO_CLRDSV:   { const ro_clrdsv* o = p; V->ClearDepthStencilView(L, o->h, o->f, o->d, (UINT8)o->stencil, o->n, o->n ? o->r : NULL); break; }
+    case RO_CLRRTV:   { const ro_clrrtv* o = p; V->ClearRenderTargetView(L, o->h, o->c, o->n, o->n ? o->r : NULL); break; }
+    case RO_DRAW:     { const ro_draw* o = p; V->DrawInstanced(L, o->a, o->b, o->c, o->d); break; }
+    case RO_DRAWIDX:  { const ro_drawidx* o = p; V->DrawIndexedInstanced(L, o->a, o->b, o->c, o->d, o->e); break; }
+    case RO_GCBV:     { const ro_cbv* o = p; V->SetGraphicsRootConstantBufferView(L, o->idx, o->va); break; }
+    case RO_G32:      { const ro_32* o = p; V->SetGraphicsRoot32BitConstants(L, o->idx, o->n, o->v, o->off); break; }
+    case RO_CRS:      V->SetComputeRootSignature(L, (ID3D12RootSignature*)((const ro_ptr*)p)->p); break;
+    case RO_GRS:      V->SetGraphicsRootSignature(L, (ID3D12RootSignature*)((const ro_ptr*)p)->p); break;
+    case RO_PSO:      V->SetPipelineState(L, (ID3D12PipelineState*)((const ro_ptr*)p)->p); break;
+    case RO_DISPATCH: { const ro_dispatch* o = p; V->Dispatch(L, o->x, o->y, o->z); break; }
+    case RO_COPYRES:  { const ro_copyres* o = p; V->CopyResource(L, o->d, o->s); break; }
+    case RO_HEAPS:    { const ro_heaps* o = p; V->SetDescriptorHeaps(L, o->n, o->h); break; }
+    case RO_VP:       { const ro_vp* o = p; V->RSSetViewports(L, o->n, o->v); break; }
+    case RO_SC:       { const ro_sc* o = p; V->RSSetScissorRects(L, o->n, o->r); break; }
+    case RO_STENCIL:  V->OMSetStencilRef(L, ((const ro_32*)p)->idx); break;
+    case RO_RTS:      { const ro_rts* o = p; V->OMSetRenderTargets(L, o->n, o->m ? o->rt : NULL, o->single, o->has_ds ? &o->ds : NULL); break; }
+    case RO_VB:       { const ro_vb* o = p; V->IASetVertexBuffers(L, o->start, o->n, o->has ? o->v : NULL); break; }
+    case RO_TOPO:     V->IASetPrimitiveTopology(L, (D3D12_PRIMITIVE_TOPOLOGY)((const ro_32*)p)->idx); break;
+    case RO_IB:       { const ro_ib* o = p; V->IASetIndexBuffer(L, o->has ? &o->v : NULL); break; }
+    case RO_ENDQ:     { const ro_endq* o = p; V->EndQuery(L, o->h, o->t, o->i); break; }
+    case RO_RESOLVEQ: { const ro_resolveq* o = p; V->ResolveQueryData(L, o->h, o->t, o->start, o->n, o->dst, o->off); break; }
+    default: break;   /* RO_WRAP */
+    }
+}
