+/* ---------------------------------------------------------------------------
+ * Decoder thread
+ * -----------------------------------------------------------------------*/
+
+static void adec_kick(AdecSlot* a)
+{
+#ifdef _WIN32
+    if (a->wake) SetEvent(a->wake);
+#else
+    (void)a;
+#endif
+}
+
+/* Lock held. */
+static void adec_post(AdecSlot* a, const AdecJob* job)
+{
+    a->jobs[(a->jobHead + a->jobCount) % ADEC_JOBS] = *job;
+    a->jobCount++;
+    adec_kick(a);
+}
+
+static void adec_run_au(CellAdecHandle handle, const AdecJob* job)
+{
+    AdecSlot* a = &s_adec[handle];
+    const u32 it = adec_slot_ea(a, a->written);
+    u32 pcm_size = 0;
+    int have = 0;
+#ifdef PS3RECOMP_FFMPEG_RUNTIME
+    if (adec_is_atrac(a->codecType))
+        have = atrac_decode(a, job->addr, job->size, it + SLOT_PCM, &pcm_size);
+#endif
+    if (!have) {
+        pcm_size = ADEC_SILENCE_BYTES;
+        for (u32 o = 0; o < pcm_size; o += 4) vm_write32(it + SLOT_PCM + o, 0);
+    }
+
+    a->auCount++;
+    vm_write32(it + PCMITEM_PCM_HANDLE, (u32)handle);
+    vm_write32(it + PCMITEM_STATUS,     0);              /* CELL_OK */
+    vm_write32(it + PCMITEM_START_ADDR, it + SLOT_PCM);
+    vm_write32(it + PCMITEM_SIZE,       pcm_size);
+    /* bsiInfo must point at a codec info block, not be null. Resistance:
+     * Fall of Man sizes each AC3 block from bsiInfo+0x14; with a null
+     * pointer that read address 0x14 and came back 0, so its ring buffer
+     * never filled, it never started its audio port, and its movie player
+     * waited forever. For ATRAC3plus it is { samplingFreq, channelConfigIndex, nbytes }. */
+    const u32 bsi = it + SLOT_BSI;
+    for (u32 o = 0; o < 0x40u; o += 4) vm_write32(bsi + o, 0);
+    if (adec_is_atrac(a->codecType)) {
+        vm_write32(bsi + 0x00, a->sampleRate ? a->sampleRate : 48000);
+        vm_write32(bsi + 0x04, a->chConfig);
+        vm_write32(bsi + 0x08, a->nbytes);
+    } else {
+        vm_write32(bsi + 0x14, pcm_size);
+    }
+    vm_write32(it + PCMITEM_BSI_INFO, bsi);
+    /* Echo the AU back, which is what a real decoder does -- the guest
+     * matches returned PCM against the AU it submitted. */
+    vm_write32(it + PCMITEM_AU_START,        job->addr);
+    vm_write32(it + PCMITEM_AU_SIZE,         job->size);
+    vm_write32(it + PCMITEM_AU_PTS_HI,       job->ptsHi);
+    vm_write32(it + PCMITEM_AU_PTS_LO,       job->ptsLo);
+    vm_write32(it + PCMITEM_AU_USERDATA,     job->userHi);
+    vm_write32(it + PCMITEM_AU_USERDATA + 4, job->userLo);
+    a->written++;
+
+    /* msgData is the AU INFO ADDRESS, not a status -- see RPCS3 Modules/cellAdec.cpp:1345.
+     * A decoder that tracks its outstanding AUs by address gets a null back otherwise. */
+    adec_notify(handle, CELL_ADEC_MSG_TYPE_AUDONE, (s32)job->auEa);
+    adec_notify(handle, CELL_ADEC_MSG_TYPE_PCMOUT, CELL_OK);
+}
+
+static void adec_worker_loop(CellAdecHandle handle)
+{
+    AdecSlot* a = &s_adec[handle];
+    for (;;) {
+        ADEC_LOCK();
+        if (a->workerStop) {
+            ADEC_UNLOCK();
+            return;
+        }
+        if (!a->jobCount) {
+            ADEC_UNLOCK();
+#ifdef _WIN32
+            WaitForSingleObject(a->wake, 50);
+#else
+            usleep(1000);
+#endif
+            continue;
+        }
+        const AdecJob job = a->jobs[a->jobHead];
+        a->jobHead = (a->jobHead + 1) % ADEC_JOBS;
+        a->jobCount--;
+        ADEC_UNLOCK();
+        switch (job.kind) {
+        case ADEC_JOB_AU:
+            adec_run_au(handle, &job);
+            break;
+        case ADEC_JOB_START: {
+#ifdef PS3RECOMP_FFMPEG_RUNTIME
+            const int ok = a->nbytes && a->chConfig ? atrac_open(a) : 0;
+#else
+            const int ok = 0;
+#endif
+            fprintf(stderr, "[cellAdec] ATRAC3plus cfg=%u nch_out=%u nbytes=%u fmt=0x%X decoder=%d%c", a->chConfig, a->nchOut,
+                    a->nbytes, a->wordFmt, ok, 10);
+            break;
+        }
+        default:
+            adec_notify(handle, CELL_ADEC_MSG_TYPE_SEQDONE, CELL_OK);
+            break;
+        }
+    }
+}
