+s32 cellUsbdControlTransfer(s32 pipe_id, u32 request_ea, u32 buf_ea, u32 done_opd, u32 arg);
+s32 cellUsbdBulkTransfer(s32 pipe_id, u32 buf_ea, s32 len, u32 done_opd, u32 arg);
+s32 cellUsbdInterruptTransfer(s32 pipe_id, u32 buf_ea, s32 len, u32 done_opd, u32 arg);
+s32 cellUsbdIsochronousTransfer(s32 pipe_id, u32 req_ea, u32 done_opd, u32 arg);
+s32 cellUsbdResetDevice(s32 dev_id);
 
 #ifdef __cplusplus
 }
diff --git a/libs/hardware/wheel.h b/libs/hardware/wheel.h
new file mode 100644
index 00000000..3c868e55
--- /dev/null
+++ b/libs/hardware/wheel.h
@@ -0,0 +1,110 @@
+/*
+ * ps3recomp - steering wheel emulation (Logitech G27 on cellUsbd)
+ *
+ * Gran Turismo 5 and 6 drive their Logitech wheels themselves: the game
+ * registers a USB device driver with cellUsbd, reads the wheel's HID reports
+ * off its interrupt IN endpoint and writes Logitech force-feedback commands to
+ * its interrupt OUT endpoint. cellUsbd.c presents one emulated G27 to the
+ * game; this header joins it to the two halves behind it:
+ *
+ *   wheel_g27.c       the G27 itself: USB descriptors, the 11-byte input
+ *                     report, and the force-feedback command decoder, which
+ *                     keeps four effect slots plus the default spring.
+ *   wheel_host_win.c  the PC wheel: DirectInput (Windows), polled on a thread
+ *                     of its own, whose effects follow the decoder's slots.
+ *
+ * Everything is off unless a wheel is found on the host (PS3_WHEEL=off turns
+ * it off even then), so a player with a pad sees no change.
+ */
+#ifndef PS3RECOMP_WHEEL_H
+#define PS3RECOMP_WHEEL_H
+
+#include "ps3emu/ps3types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* G27 buttons, by the PS3 function each one has (bit = 1 << index). The order
+ * is the G27's own report order, which a G29/G923 also uses for DirectInput
+ * button numbers 0-22, so "host button i -> WHEEL_BTN i" is the default map. */
+enum {
+    WHEEL_BTN_CROSS = 0, WHEEL_BTN_SQUARE, WHEEL_BTN_CIRCLE, WHEEL_BTN_TRIANGLE,
+    WHEEL_BTN_R1, WHEEL_BTN_L1, WHEEL_BTN_R2, WHEEL_BTN_L2,
+    WHEEL_BTN_SELECT, WHEEL_BTN_START, WHEEL_BTN_R3, WHEEL_BTN_L3,
+    WHEEL_BTN_GEAR1, WHEEL_BTN_GEAR2, WHEEL_BTN_GEAR3, WHEEL_BTN_GEAR4,
+    WHEEL_BTN_GEAR5, WHEEL_BTN_GEAR6, WHEEL_BTN_GEAR_R,
+    WHEEL_BTN_PLUS, WHEEL_BTN_MINUS, WHEEL_BTN_DIAL_CW, WHEEL_BTN_DIAL_CCW,
+    WHEEL_BTN_COUNT
+};
+
+typedef struct WheelInput {
+    int   connected;
+    float steer;        /* -1 (full left) .. +1 (full right) over the host wheel's range */
+    float throttle;     /* 0 released .. 1 floored */
+    float brake;
+    float clutch;
+    int   hat;          /* 0 = up, 1 = up-right ... 7 = up-left, -1 = centred */
+    u32   buttons;      /* 1 << WHEEL_BTN_* */
+    int   shifter;      /* an H-shifter is attached (or PS3_WHEEL_SHIFTER=1) */
+} WheelInput;
+
+/* ---- the force-feedback model the decoder keeps (wheel_g27.c) ---- */
+
+enum {
+    WHEEL_FX_NONE = 0,
+    WHEEL_FX_CONSTANT,  /* level */
+    WHEEL_FX_SPRING,    /* condition: center, deadband, k_neg/k_pos, sat */
+    WHEEL_FX_DAMPER,    /* condition: k_neg/k_pos, sat */
+    WHEEL_FX_FRICTION,  /* condition: k_neg/k_pos, sat */
+    WHEEL_FX_SQUARE,    /* periodic: magnitude, offset, period_ms */
+    WHEEL_FX_SAW_UP,
+    WHEEL_FX_SAW_DOWN,
+    WHEEL_FX_TRIANGLE,
+};
+
+typedef struct WheelEffect {
+    int   type;         /* WHEEL_FX_* */
+    int   playing;
+    float level;        /* constant: -1..+1 (byte 0x80 = 0). + pushes the rim LEFT on a
+                         * G27: GT5 sends 0x90-0xF0 to pull a wheel held right back to
+                         * the centre, below 0x80 for one held left. It goes to
+                         * DirectInput with the same sign (a force from the right). */
+    float center;       /* condition: -1..+1 (rim position) */
+    float deadband;     /* condition: half width, 0..1 */
+    float k_neg, k_pos; /* condition: -1..+1 left / right of the dead band */
+    float sat;          /* condition: 0..1 */
+    float magnitude;    /* periodic: 0..1 */
+    float offset;       /* periodic: -1..+1 */
+    u32   period_ms;    /* periodic */
+} WheelEffect;
+
+#define WHEEL_FFB_SLOTS 4
+
+typedef struct WheelFfb {
+    u32         gen;            /* bumped on every change */
+    WheelEffect slot[WHEEL_FFB_SLOTS];
+    WheelEffect def_spring;     /* the wheel's own centring spring (cmd 0x0E) */
+    int         def_spring_on;  /* cmd 0x04 / 0x05 */
+    int         range_deg;      /* rotation the game asked for (0xF8 0x81 ...), 0 = never */
+} WheelFfb;
+
+/* ---- wheel_g27.c ---- */
+u32  wheel_g27_descriptors(u8* out, u32 cap);          /* device + config blob, USB byte order */
+int  wheel_g27_report(const WheelInput* in, u8 out[11]); /* -> 11 */
+void wheel_g27_output(const u8* data, u32 len);        /* an OUT report from the game */
+void wheel_g27_ffb_snapshot(WheelFfb* out);            /* consistent copy, under the lock */
+void wheel_g27_reset(void);                            /* back to power-on state */
+
+/* ---- wheel_host_win.c (stubs elsewhere) ---- */
+int  wheel_host_start(void);              /* 1 if the feature is on and the thread runs */
+void wheel_host_stop(void);
+int  wheel_host_read(WheelInput* out);    /* latest state; returns out->connected */
+void wheel_host_ffb_changed(void);        /* the decoder's slots changed: resync soon */
+int  wheel_trace_on(void);                /* PS3_WHEEL_TRACE */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PS3RECOMP_WHEEL_H */
diff --git a/libs/hardware/wheel_g27.c b/libs/hardware/wheel_g27.c
new file mode 100644
index 00000000..ab065052
--- /dev/null
+++ b/libs/hardware/wheel_g27.c
@@ -0,0 +1,395 @@
+/*
+ * ps3recomp - the emulated Logitech G27 (see wheel.h)
+ *
+ * Descriptors: a G27 in its native mode (046D:C29B, bcdDevice 0x1350), as GT5
+ * expects to find one. GT5's attach (0xC21878) reads them through
+ * cellUsbdScanStaticDescriptor and opens the interrupt pipes it finds; its
+ * "genuine device" check after SET_CONFIGURATION wants bMaxPacketSize0 > 8.
+ *
+ * Input report, 11 bytes, as GT5's decoder (0xC1FCE8) reads it:
+ *   0  bits 0-3 hat (8 = centred), 4 cross, 5 square, 6 circle, 7 triangle
+ *   1  R1, L1, R2, L2, select, start, R3, L3 (bits 0-7)
+ *   2  bits 0-5 gears 1-6, 6 dial clockwise, 7 dial anticlockwise
+ *   3  bit 0 plus, bit 1 minus, bits 2-7 steering bits 0-5
+ *   4  steering bits 6-13 (0 = full left, 0x2000 centre, 0x3FFF full right)
+ *   5  throttle, 6 brake, 7 clutch (0xFF released, 0x00 floored)
+ *   8  shifter X, 9 shifter Y
+ *   10 bit 0 reverse, 1 pedals detached, 2 powered, 3 shifter attached,
+ *      4 always set, 6 shifter pressed down, 7 range above 360 degrees
+ *
+ * Output: Logitech's "classic" force-feedback protocol, 7-byte commands. The
+ * high nibble of byte 0 picks force slots 0-3, the low nibble is the command;
+ * 0xF8 starts an extended command (byte 1). The decoder keeps the four slots
+ * and the default spring in a WheelFfb, which the host side mirrors onto the
+ * PC wheel's own effects.
+ */
+#include "wheel.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+/* ---------------------------------------------------------------------------
+ * A small lock: the game's USB event thread writes commands, the host wheel
+ * thread takes snapshots.
+ * -------------------------------------------------------------------------*/
+static volatile char s_lock;
+static void g27_lock(void)   { while (__atomic_test_and_set(&s_lock, __ATOMIC_ACQUIRE)) { } }
+static void g27_unlock(void) { __atomic_clear(&s_lock, __ATOMIC_RELEASE); }
+
+static WheelFfb s_ffb;
+
+/* ---------------------------------------------------------------------------
+ * Descriptors
+ * -------------------------------------------------------------------------*/
+static const u8 k_g27_desc[] = {
+    /* device */
+    18, 0x01, 0x00, 0x02,       /* USB 2.0 */
+    0x00, 0x00, 0x00,           /* class per interface */
+    16,                         /* bMaxPacketSize0 */
+    0x6D, 0x04, 0x9B, 0xC2,     /* 046D:C29B */
+    0x50, 0x13,                 /* bcdDevice 13.50 */
+    1, 2, 0,                    /* manufacturer, product, no serial */
+    1,                          /* one configuration */
+    /* configuration */
+    9, 0x02, 41, 0x00, 1, 1, 4, 0x80, 0x31,
+    /* interface 0: HID, two endpoints */
+    9, 0x04, 0, 0, 2, 0x03, 0x00, 0x00, 0,
+    /* HID 1.11, report descriptor 133 bytes */
+    9, 0x21, 0x11, 0x01, 0x21, 1, 0x22, 0x85, 0x00,
+    /* interrupt IN 0x81 and OUT 0x01, 16 bytes, every 2 ms */
+    7, 0x05, 0x81, 0x03, 16, 0, 2,
+    7, 0x05, 0x01, 0x03, 16, 0, 2,
+};
+
+u32 wheel_g27_descriptors(u8* out, u32 cap)
+{
+    u32 n = (u32)sizeof(k_g27_desc);
+    if (n > cap) n = cap;
+    memcpy(out, k_g27_desc, n);
+    return n;
+}
+
+/* ---------------------------------------------------------------------------
+ * Input report
+ * -------------------------------------------------------------------------*/
+static int env_int(const char* name, int def)
+{
+    const char* e = getenv(name);
+    return (e && *e) ? atoi(e) : def;
+}
+
+/* Lever position per gear, as a G27 shifter reports it. */
+static const u8 k_shift_xy[8][2] = {
+    { 0x80, 0x80 },                 /* neutral */
+    { 0x30, 0xB7 }, { 0x30, 0x32 }, /* 1, 2 */
+    { 0x80, 0xB7 }, { 0x80, 0x32 }, /* 3, 4 */
+    { 0xB3, 0xB7 }, { 0xB3, 0x32 }, /* 5, 6 */
+    { 0xAA, 0x32 },                 /* reverse */
+};
+
+static u8 pedal_byte(float v)
+{
+    if (v < 0.f) v = 0.f;
+    if (v > 1.f) v = 1.f;
+    return (u8)(255 - (int)(v * 255.f + 0.5f));
+}
+
+int wheel_g27_report(const WheelInput* in, u8 r[11])
+{
+    static int host_range = -1;
+    if (host_range < 0) {
+        host_range = env_int("PS3_WHEEL_RANGE", 900);
+        if (host_range < 90 || host_range > 3600) host_range = 900;
+    }
+    memset(r, 0, 11);
+    const u32 b = in->buttons;
+    const int hat = (in->hat >= 0 && in->hat < 8) ? in->hat : 8;
+    r[0] = (u8)(hat | ((b & 0xF) << 4));                       /* cross..triangle */
+    r[1] = (u8)((b >> WHEEL_BTN_R1) & 0xFF);                   /* R1..L3 */
+    r[2] = (u8)(((b >> WHEEL_BTN_GEAR1) & 0x3F)
+              | (((b >> WHEEL_BTN_DIAL_CW) & 1) << 6)
+              | (((b >> WHEEL_BTN_DIAL_CCW) & 1) << 7));
+
+    /* The game's rotation, if it set one: the G27 reports full lock at half its
+     * range, so a 900-degree PC wheel driving a 200-degree G27 reaches the stop
+     * at 100 degrees and saturates past it, as the real wheel would. */
+    int game_range = __atomic_load_n(&s_ffb.range_deg, __ATOMIC_RELAXED);
+    if (game_range < 40 || game_range > 3600) game_range = host_range;
+    float s = in->steer * (float)host_range / (float)game_range;
+    if (s < -1.f) s = -1.f;
+    if (s > 1.f) s = 1.f;
+    int st = 0x2000 + (int)(s * 8192.f);
+    if (st < 0) st = 0;
+    if (st > 0x3FFF) st = 0x3FFF;
+    r[3] = (u8)(((b >> WHEEL_BTN_PLUS) & 1) | (((b >> WHEEL_BTN_MINUS) & 1) << 1) | ((st & 0x3F) << 2));
+    r[4] = (u8)(st >> 6);
+
+    r[5] = pedal_byte(in->throttle);
+    r[6] = pedal_byte(in->brake);
+    r[7] = pedal_byte(in->clutch);
+
+    int gear = 0;
+    for (int g = 0; g < 6; g++) if (b & (1u << (WHEEL_BTN_GEAR1 + g))) gear = g + 1;
+    const int rev = (b >> WHEEL_BTN_GEAR_R) & 1;
+    if (rev) gear = 7;
+    r[8] = k_shift_xy[gear][0];
+    r[9] = k_shift_xy[gear][1];
+    r[10] = (u8)(rev | 0x04 | (in->shifter ? 0x08 : 0) | 0x10 | (rev ? 0x40 : 0)
+               | (game_range > 360 ? 0x80 : 0));
+    return 11;
+}
+
+/* ---------------------------------------------------------------------------
+ * Force feedback
+ * -------------------------------------------------------------------------*/
+static float f_level(u8 v)     /* 0x80 is no force; 0x7F counts as none too */
+{
+    if (v == 0x7F || v == 0x80) return 0.f;
+    float f = ((float)v - 128.f) / 127.f;
+    return f < -1.f ? -1.f : (f > 1.f ? 1.f : f);
+}
+static float f_pos8(u8 v)      { return ((float)v - 127.5f) / 127.5f; }
+static float f_pos11(int v)    { return ((float)v - 1023.5f) / 1023.5f; }
+static float f_k(int k, int sign, int bits)
+{
+    const float max = (float)((1 << bits) - 1);
+    float f = (float)k / max;
+    return sign ? -f : f;
+}
+
+static void spring_from(WheelEffect* e, float d1, float d2, float k1, float k2, float sat)
+{
+    e->type = WHEEL_FX_SPRING;
+    if (d2 < d1) { float t = d1; d1 = d2; d2 = t; }
+    e->center = (d1 + d2) * 0.5f;
+    e->deadband = (d2 - d1) * 0.5f;
+    e->k_neg = k1;
+    e->k_pos = k2;
+    e->sat = sat;
+}
+
+/* Byte 1 is the force type, bytes 2-6 its parameters. `slot` matters for the
+ * constant force (each slot has its own level byte) and the variable force. */
+static int decode_effect(const u8* c, int slot, WheelEffect* e)
+{
+    const int playing = e->playing;
+    memset(e, 0, sizeof(*e));
+    e->playing = playing;
+    switch (c[1]) {
+    case 0x00:  /* constant: level per slot in bytes 2-5 */
+        e->type = WHEEL_FX_CONSTANT;
+        e->level = f_level(c[2 + (slot & 3)]);
+        return 1;
+    case 0x01:  /* spring: dead band D1/D2, K1/K2 (3 bits), S1/S2, clip */
+        spring_from(e, f_pos8(c[2]), f_pos8(c[3]),
+                    f_k(c[4] & 7, c[5] & 1, 3), f_k((c[4] >> 4) & 7, (c[5] >> 4) & 1, 3),
+                    (float)c[6] / 255.f);
+        return 1;
+    case 0x0B: { /* high-resolution spring: 11-bit dead band, 4-bit K */
+        const int d1 = (c[2] << 3) | ((c[5] >> 1) & 7);
+        const int d2 = (c[3] << 3) | ((c[5] >> 5) & 7);
+        spring_from(e, f_pos11(d1), f_pos11(d2),
+                    f_k(c[4] & 15, c[5] & 1, 4), f_k((c[4] >> 4) & 15, (c[5] >> 4) & 1, 4),
+                    (float)c[6] / 255.f);
+        return 1; }
+    case 0x03:  /* auto-centre spring: K1/K2 (3 bits), clip */
+        spring_from(e, 0.f, 0.f, f_k(c[2] & 7, 0, 3), f_k(c[3] & 7, 0, 3), (float)c[4] / 255.f);
+        return 1;
+    case 0x0D:  /* high-resolution auto-centre spring */
+        spring_from(e, 0.f, 0.f, f_k(c[2] & 15, 0, 4), f_k(c[3] & 15, 0, 4), (float)c[4] / 255.f);
+        return 1;
+    case 0x02:  /* damper: K1, S1, K2, S2 (3 bits), no clip */
+        e->type = WHEEL_FX_DAMPER;
+        e->k_neg = f_k(c[2] & 7, c[3] & 1, 3);
+        e->k_pos = f_k(c[4] & 7, c[5] & 1, 3);
+        e->sat = 1.f;
+        return 1;
+    case 0x0C:  /* high-resolution damper: 4-bit K, clip */
+        e->type = WHEEL_FX_DAMPER;
+        e->k_neg = f_k(c[2] & 15, c[3] & 1, 4);
+        e->k_pos = f_k(c[4] & 15, c[5] & 1, 4);
+        e->sat = (float)c[6] / 255.f;
+        return 1;
+    case 0x0E:  /* friction: K1, K2 (8 bits), clip, S1/S2 */
+        e->type = WHEEL_FX_FRICTION;
+        e->k_neg = f_k(c[2], c[5] & 1, 8);
+        e->k_pos = f_k(c[3], (c[5] >> 4) & 1, 8);
+        e->sat = (float)c[4] / 255.f;
+        return 1;
+    case 0x04:  /* sawtooth up / down: L1 high, L2 low, L0 start, T/I in byte 6 */
+    case 0x05: {
+        const int hi = c[2], lo = c[3];
+        const int t = (c[6] >> 4) & 15, inc = c[6] & 15;
+        e->type = c[1] == 0x04 ? WHEEL_FX_SAW_UP : WHEEL_FX_SAW_DOWN;
+        e->magnitude = (float)abs(hi - lo) / 255.f;
+        e->offset = f_level((u8)((hi + lo) / 2));
+        e->period_ms = (u32)(abs(hi - lo) / (inc ? inc : 1) * (t ? t : 1) * 2);
+        return 1; }
+    case 0x06:  /* trapezoid: L1, L2, T1 at L1, T2 at L2, slope in byte 6 */
+    case 0x07: { /* rectangle: L1, L2, T1, T2, phase */
+        const int hi = c[2], lo = c[3];
+        e->type = c[1] == 0x06 ? WHEEL_FX_TRIANGLE : WHEEL_FX_SQUARE;
+        e->magnitude = (float)abs(hi - lo) / 255.f;
+        e->offset = f_level((u8)((hi + lo) / 2));
+        e->period_ms = (u32)((c[4] + c[5]) * 2);
+        return 1; }
+    case 0x0A:  /* square: amplitude, 16-bit half period, count */
+        e->type = WHEEL_FX_SQUARE;
+        e->magnitude = (float)c[2] / 255.f;
+        e->period_ms = (u32)((c[3] | (c[4] << 8)) * 2);
+        return 1;
+    case 0x08:  /* variable force: slots 0 and 2 only, level L1 / L2 */
+    case 0x09:  /* ramp: start from L1 */
+        e->type = WHEEL_FX_CONSTANT;
+        e->level = f_level((slot & 2) ? c[3] : c[2]);
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+/* Logging, so a player's logs\play.err says what the game asked of the wheel:
+ * every command once it is decoded, except the two the game repeats many times
+ * a second in a race (the steering force and the rev lights), which are summed
+ * up every 30 s instead. PS3_WHEEL_TRACE=1 logs those one by one as well. */
+static unsigned s_trace_lines;
+static struct { unsigned n, leds; float lo, hi; time_t t0; } s_sum;
+
+static void sum_flush(int force)
+{
+    const time_t now = time(NULL);
+    if (!s_sum.t0) s_sum.t0 = now;
+    if (!force && now - s_sum.t0 < 30) return;
+    if (s_sum.n || s_sum.leds)
+        fprintf(stderr, "[wheel] ffb last %lds: %u steering-force updates (level %+.2f..%+.2f), %u rev-light updates\n",
+                (long)(now - s_sum.t0), s_sum.n, s_sum.n ? s_sum.lo : 0.f, s_sum.n ? s_sum.hi : 0.f, s_sum.leds);
+    memset(&s_sum, 0, sizeof s_sum);
+    s_sum.t0 = now;
+}
+
+static void trace_cmd(const char* what, const u8* c)
+{
+    if (s_trace_lines >= (wheel_trace_on() ? 20000u : 400u)) return;
+    s_trace_lines++;
+    fprintf(stderr, "[wheel] ffb %-10s %02X %02X %02X %02X %02X %02X %02X\n",
+            what, c[0], c[1], c[2], c[3], c[4], c[5], c[6]);
+}
+
+/* The steering force and rev lights: one by one only with PS3_WHEEL_TRACE. */
+static void note_frequent(const char* what, const u8* c, int is_force, float level)
+{
+    if (is_force) {
+        if (!s_sum.n || level < s_sum.lo) s_sum.lo = level;
+        if (!s_sum.n || level > s_sum.hi) s_sum.hi = level;
+        s_sum.n++;
+    } else {
+        s_sum.leds++;
+    }
+    if (wheel_trace_on()) trace_cmd(what, c);
+    sum_flush(0);
+}
+
+/* One 7-byte command. Returns 1 if the effect state changed. */
+static int g27_command(const u8* c)
+{
+    if (c[0] == 0xF8) {   /* extended */
+        switch (c[1]) {
+        case 0x02: s_ffb.range_deg = 200; trace_cmd("range200", c); return 1;
+        case 0x03: s_ffb.range_deg = 900; trace_cmd("range900", c); return 1;
+        case 0x81: s_ffb.range_deg = c[2] | (c[3] << 8); trace_cmd("range", c); return 1;
+        case 0x12: note_frequent("leds", c, 0, 0.f); return 0;   /* rev lights */
+        default:   trace_cmd("ext", c); return 0;           /* mode switches: already native */
+        }
+    }
+    const int cmd = c[0] & 0x0F, mask = c[0] >> 4;
+    int changed = 0;
+    switch (cmd) {
+    case 0x0:   /* download */
+    case 0x1:   /* download and play */
+    case 0xC:   /* refresh */
+        for (int s = 0; s < WHEEL_FFB_SLOTS; s++) {
+            if (!(mask & (1 << s))) continue;
+            WheelEffect* e = &s_ffb.slot[s];
+            const int was = e->type;
+            if (!decode_effect(c, s, e)) { trace_cmd("type?", c); continue; }
+            if (cmd == 0x0) e->playing = 0;
+            if (cmd == 0x1) e->playing = 1;
+            if (cmd == 0xC && was == WHEEL_FX_NONE) e->playing = 1;  /* refresh of an empty slot starts it */
+            changed = 1;
+        }
+        if (changed) {
+            const char* what = cmd == 0 ? "download" : cmd == 1 ? "dl+play" : "refresh";
+            /* Constant / variable / ramp: the race's steering force, many a second. */
+            if (c[1] == 0x00 || c[1] == 0x08 || c[1] == 0x09) {
+                int s = 0;
+                while (s < WHEEL_FFB_SLOTS - 1 && !(mask & (1 << s))) s++;
+                note_frequent(what, c, 1, s_ffb.slot[s].level);
+            } else {
+                trace_cmd(what, c);
+            }
+        }
+        break;
+    case 0x2:   /* play */
+    case 0x3:   /* stop */
+        for (int s = 0; s < WHEEL_FFB_SLOTS; s++)
+            if (mask & (1 << s)) { s_ffb.slot[s].playing = cmd == 0x2; changed = 1; }
+        trace_cmd(cmd == 2 ? "play" : "stop", c);
+        break;
+    case 0x4:   /* default spring on */
+    case 0x5:   /* default spring off */
+        s_ffb.def_spring_on = cmd == 0x4;
+        changed = 1;
+        trace_cmd(cmd == 4 ? "defspr on" : "defspr off", c);
+        break;
+    case 0xE:   /* set default spring: K1, K2 (3 bits), clip */
+        spring_from(&s_ffb.def_spring, 0.f, 0.f, f_k(c[2] & 7, 0, 3), f_k(c[3] & 7, 0, 3),
+                    (float)c[4] / 255.f);
+        changed = 1;
+        trace_cmd("defspr set", c);
+        break;
+    default:    /* 0x8 normal mode, 0x9 LED, 0xA watchdog, 0xB raw, 0xD loop, 0xF dead band */
+        trace_cmd("other", c);
+        break;
+    }
+    return changed;
+}
+
+void wheel_g27_output(const u8* data, u32 len)
+{
+    if (!data || len < 7) return;
+    /* Refreshes of the constant force are most of the traffic in a race;
+     * trace the first few and then only every 64th, so the log stays small. */
+    static unsigned n;
+    if (wheel_trace_on() && (n++ < 64 || (n & 63) == 0) && s_trace_lines < 4000) {
+        s_trace_lines++;
+        fprintf(stderr, "[wheel] out len=%u:", len);
+        for (u32 i = 0; i < len && i < 16; i++) fprintf(stderr, " %02X", data[i]);
+        fprintf(stderr, "\n");
+    }
+    g27_lock();
+    int changed = g27_command(data);
+    if (changed) s_ffb.gen++;
+    g27_unlock();
+    if (changed) wheel_host_ffb_changed();
+}
+
+void wheel_g27_ffb_snapshot(WheelFfb* out)
+{
+    g27_lock();
+    *out = s_ffb;
+    g27_unlock();
+}
+
+void wheel_g27_reset(void)
+{
+    g27_lock();
+    const u32 gen = s_ffb.gen;
+    memset(&s_ffb, 0, sizeof(s_ffb));
+    /* Power-on: the wheel's own centring spring is on until a game turns it off. */
+    spring_from(&s_ffb.def_spring, 0.f, 0.f, f_k(3, 0, 3), f_k(3, 0, 3), 1.f);
+    s_ffb.def_spring_on = 1;
+    s_ffb.gen = gen + 1;
+    g27_unlock();
+    wheel_host_ffb_changed();
+}
diff --git a/libs/hardware/wheel_host_win.c b/libs/hardware/wheel_host_win.c
new file mode 100644
index 00000000..f6988848
--- /dev/null
+++ b/libs/hardware/wheel_host_win.c
@@ -0,0 +1,709 @@
+/*
+ * ps3recomp - the PC steering wheel behind the emulated G27 (see wheel.h)
+ *
+ * Windows: DirectInput 8, which every wheel driver (Logitech G HUB / LGS,
+ * Thrustmaster, Fanatec) serves, force feedback included. One thread owns the
+ * device: it looks for a wheel every few seconds until one is there, polls it
+ * every millisecond, publishes a WheelInput, and keeps the wheel's effects in
+ * step with the four force slots and default spring the G27 decoder holds.
+ *
+ * Settings (environment):
+ *   PS3_WHEEL            unset/auto: use the first wheel found.  off: never.
+ *                        (The game controllers seen are listed once in the log.)
+ *                        virtual: a G27 with no PC device behind it, for testing
+ *                        the game side; PS3_WHEEL_VIRTUAL=steer=-1,throttle=1,delay=190
+ *                        holds the rim and pedals there from that second on.
+ *                        anything else: a wheel whose name or VID:PID contains it.
+ *   PS3_WHEEL_RANGE      degrees of rotation the PC wheel is set to (900).
+ *   PS3_WHEEL_FFB        force feedback strength in percent (100; 0 = off).
+ *   PS3_WHEEL_FFB_INVERT 1 = the game's constant forces push the other way.
+ *   PS3_WHEEL_PEDALS     e.g. throttle=Y,brake=RZ,clutch=Z (axes X Y Z RX RY RZ S0 S1);
+ *                        add inv to a pedal (brake=RZinv) if it reads backwards.
+ *   PS3_WHEEL_STEER      steering axis (X).
+ *   PS3_WHEEL_BUTTONS    e.g. cross=1,circle=3,start=10, by the numbers Windows'
+ *                        Game Controllers panel shows (1 = first button).
+ *   PS3_WHEEL_SHIFTER    1/0: report an H-shifter attached or not (default: once
+ *                        a gear is engaged).
+ *   PS3_WHEEL_TRACE      1 = log what the wheel and the game exchange.
+ */
+#include "wheel.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+
+static int s_trace = -1;
+int wheel_trace_on(void)
+{
+    if (s_trace < 0) { const char* e = getenv("PS3_WHEEL_TRACE"); s_trace = (e && *e && *e != '0') ? 1 : 0; }
+    return s_trace;
+}
+
+#ifdef _WIN32
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#define DIRECTINPUT_VERSION 0x0800
+#include <windows.h>
+#include <dinput.h>
+#pragma comment(lib, "dinput8.lib")
+#pragma comment(lib, "dxguid.lib")
+
+/* ---------------------------------------------------------------------------
+ * Settings
+ * -------------------------------------------------------------------------*/
+enum { AX_X, AX_Y, AX_Z, AX_RX, AX_RY, AX_RZ, AX_S0, AX_S1, AX_COUNT, AX_NONE = -1 };
+static const char* const k_axis_name[AX_COUNT] = { "X", "Y", "Z", "RX", "RY", "RZ", "S0", "S1" };
+
+static const char* const k_btn_name[WHEEL_BTN_COUNT] = {
+    "cross", "square", "circle", "triangle", "r1", "l1", "r2", "l2",
+    "select", "start", "r3", "l3", "gear1", "gear2", "gear3", "gear4",
+    "gear5", "gear6", "gearr", "plus", "minus", "dialcw", "dialccw",
+};
+
+enum { MODE_OFF, MODE_AUTO, MODE_MATCH, MODE_VIRTUAL };
+
+typedef struct {
+    int  steer;
+    int  pedal[3];          /* throttle, brake, clutch: AX_* or AX_NONE */
+    int  pedal_inv[3];      /* -1 = released where it rests (see pedal()), 2 = the other end */
+    int  btn[WHEEL_BTN_COUNT];  /* host button index (0-based) per G27 button, -1 = none */
+} WheelMap;
+
+static int   s_mode = -1;
+static char  s_match[128];
+static int   s_list = 1;      /* print every game controller on the first look */
+static int   s_gain = 100;
+static float s_ffb_sign = 1.f;
+static int   s_shifter_cfg = -1;
+
+static void lower(char* s) { for (; *s; s++) *s = (char)tolower((unsigned char)*s); }
+
+static void read_settings(void)
+{
+    if (s_mode >= 0) return;
+    const char* e = getenv("PS3_WHEEL");
+    char v[128] = "";
+    if (e) { snprintf(v, sizeof v, "%s", e); lower(v); }
+    if (!*v || !strcmp(v, "auto") || !strcmp(v, "1") || !strcmp(v, "on")) s_mode = MODE_AUTO;
+    else if (!strcmp(v, "off") || !strcmp(v, "0") || !strcmp(v, "no")) s_mode = MODE_OFF;
+    else if (!strcmp(v, "list")) s_mode = MODE_AUTO;   /* kept: the list is always printed once now */
+    else if (!strcmp(v, "virtual")) s_mode = MODE_VIRTUAL;
+    else { s_mode = MODE_MATCH; snprintf(s_match, sizeof s_match, "%s", v); }
+    e = getenv("PS3_WHEEL_FFB");
+    if (e && *e) { s_gain = atoi(e); if (s_gain < 0) s_gain = 0; if (s_gain > 100) s_gain = 100; }
+    e = getenv("PS3_WHEEL_FFB_INVERT");
+    if (e && *e == '1') s_ffb_sign = -1.f;
+    e = getenv("PS3_WHEEL_SHIFTER");
+    if (e && *e) s_shifter_cfg = (*e == '1');
+}
+
+static int axis_by_name(const char* s, int* inv)
+{
+    char n[16]; int i = 0;
+    while (s[i] && s[i] != ',' && i < 15) { n[i] = (char)toupper((unsigned char)s[i]); i++; }
+    n[i] = 0;
+    *inv = -1;
+    char* p = strstr(n, "INV");
+    if (p) { *p = 0; *inv = 2; }   /* 2 = flip whatever the default is */
+    for (int a = 0; a < AX_COUNT; a++) if (!strcmp(n, k_axis_name[a])) return a;
+    if (!strcmp(n, "SLIDER") || !strcmp(n, "SLIDER0")) return AX_S0;
+    if (!strcmp(n, "NONE")) return AX_NONE;
+    return -2;
+}
+
+/* Defaults by model, then the PS3_WHEEL_* overrides. */
+static void build_map(WheelMap* m, u16 vid, u16 pid)
+{
+    m->steer = AX_X;
+    for (int i = 0; i < WHEEL_BTN_COUNT; i++) m->btn[i] = i;   /* G29/G923 order */
+    /* Pedals rest at the top of their range on Logitech wheels. Axis usage
+     * differs: G29 / G923 (PlayStation) put the clutch on Z and the brake on
+     * Rz, the G920 / G923 (Xbox) the other way round. */
+    m->pedal[0] = AX_Y; m->pedal[1] = AX_RZ; m->pedal[2] = AX_Z;
+    m->pedal_inv[0] = m->pedal_inv[1] = m->pedal_inv[2] = -1;
+    if (vid == 0x046D) {
+        if (pid == 0xC262 || pid == 0xC26D || pid == 0xC26E) {   /* G920, G923 Xbox */
+            static const int xb[] = {
+                WHEEL_BTN_CROSS, WHEEL_BTN_CIRCLE, WHEEL_BTN_SQUARE, WHEEL_BTN_TRIANGLE,
+                WHEEL_BTN_R1, WHEEL_BTN_L1, WHEEL_BTN_START, WHEEL_BTN_SELECT,
+                WHEEL_BTN_R3, WHEEL_BTN_L3 };
+            for (int i = 0; i < WHEEL_BTN_COUNT; i++)
+                if (i < WHEEL_BTN_GEAR1) m->btn[i] = -1;
+            for (int h = 0; h < 10; h++) m->btn[xb[h]] = h;
+            m->pedal[1] = AX_Z; m->pedal[2] = AX_RZ;
+        } else if (pid == 0xC299 || pid == 0xC29A || pid == 0xC29B || pid == 0xC298 || pid == 0xC294) {
+            m->pedal[1] = AX_Z; m->pedal[2] = AX_RZ;              /* G25 / DFGT / G27 / DFP */
+        }
+    }
+    const char* e = getenv("PS3_WHEEL_STEER");
+    int inv;
+    if (e && *e) { int a = axis_by_name(e, &inv); if (a >= 0) m->steer = a; }
+    e = getenv("PS3_WHEEL_PEDALS");
+    if (e && *e) {
+        static const char* const pn[3] = { "throttle", "brake", "clutch" };
+        char buf[256]; snprintf(buf, sizeof buf, "%s", e); lower(buf);
+        for (int p = 0; p < 3; p++) {
+            const char* at = strstr(buf, pn[p]);
+            if (!at || at[strlen(pn[p])] != '=') continue;
+            int a = axis_by_name(at + strlen(pn[p]) + 1, &inv);
+            if (a == -2) continue;
+            m->pedal[p] = a;
+            if (inv == 2) m->pedal_inv[p] = 2;
+        }
+    }
+    e = getenv("PS3_WHEEL_BUTTONS");
+    if (e && *e) {
+        char buf[512]; snprintf(buf, sizeof buf, "%s", e); lower(buf);
+        for (char* tok = strtok(buf, ",; "); tok; tok = strtok(NULL, ",; ")) {
+            char* eq = strchr(tok, '=');
+            if (!eq) continue;
+            *eq = 0;
+            for (int i = 0; i < WHEEL_BTN_COUNT; i++)
+                if (!strcmp(tok, k_btn_name[i])) m->btn[i] = atoi(eq + 1) - 1;   /* 1-based, 0 = none */
+        }
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * Published state
+ * -------------------------------------------------------------------------*/
+static SRWLOCK      s_pub_lock = SRWLOCK_INIT;
+static WheelInput   s_pub;
+static HANDLE       s_thread;
+static volatile LONG s_stop;
+static volatile LONG s_ffb_dirty = 1;
+static int          s_started;
+
+int wheel_host_read(WheelInput* out)
+{
+    AcquireSRWLockShared(&s_pub_lock);
+    *out = s_pub;
+    ReleaseSRWLockShared(&s_pub_lock);
+    return out->connected;
+}
+
+void wheel_host_ffb_changed(void) { InterlockedExchange(&s_ffb_dirty, 1); }
+
+static void publish(const WheelInput* in)
+{
+    AcquireSRWLockExclusive(&s_pub_lock);
+    s_pub = *in;
+    ReleaseSRWLockExclusive(&s_pub_lock);
+}
+
+/* ---------------------------------------------------------------------------
+ * Device
+ * -------------------------------------------------------------------------*/
+static LPDIRECTINPUT8W       s_di;
+static LPDIRECTINPUTDEVICE8W s_dev;
+static HWND                  s_hwnd;
+static int                   s_has_ffb;
+static u16                   s_vid, s_pid;
+static char                  s_name[260];
+static WheelMap              s_map;
+static int                   s_rest_known;
+static LONG                  s_rest[AX_COUNT];
+static int                   s_axis_present[AX_COUNT];
+static int                   s_shifter_seen;
+static ULONGLONG             s_ffb_retry_at;
+
+typedef struct {
+    GUID inst;
+    char name[260];
+    u16  vid, pid;
+    int  score;
+} Cand;
+
+static void utf8(const WCHAR* w, char* out, int cap)
+{
+    if (!WideCharToMultiByte(CP_UTF8, 0, w, -1, out, cap, NULL, NULL)) out[0] = 0;
+}
+
+static int contains_ci(const char* hay, const char* needle)
+{
+    char h[300]; snprintf(h, sizeof h, "%s", hay); lower(h);
+    return strstr(h, needle) != NULL;
+}
+
+static int s_enum_count;
+
+static BOOL CALLBACK enum_cb(LPCDIDEVICEINSTANCEW di, LPVOID ctx)
+{
+    Cand* best = (Cand*)ctx;
+    s_enum_count++;
+    Cand c; memset(&c, 0, sizeof c);
+    c.inst = di->guidInstance;
+    utf8(di->tszProductName, c.name, sizeof c.name);
+    c.vid = LOWORD(di->guidProduct.Data1);
+    c.pid = HIWORD(di->guidProduct.Data1);
+    static const u8 zero[sizeof(GUID)];
+    const int ff = memcmp(&di->guidFFDriver, zero, sizeof(GUID)) != 0;
+    const int driving = GET_DIDEVICE_TYPE(di->dwDevType) == DI8DEVTYPE_DRIVING;
+    char vp[16]; snprintf(vp, sizeof vp, "%04x:%04x", c.vid, c.pid);
+    if (s_list)
+        fprintf(stderr, "[wheel] found %s \"%s\"%s%s\n", vp, c.name,
+                driving ? " (wheel)" : "", ff ? " (force feedback)" : "");
+    if (s_mode == MODE_MATCH) {
+        c.score = (contains_ci(c.name, s_match) || strstr(vp, s_match)) ? 10 : 0;
+    } else {
+        if (driving) c.score += 4;
+        if (ff) c.score += 1;
+        if (contains_ci(c.name, "wheel") || contains_ci(c.name, "racing") ||
+            contains_ci(c.name, "driving force"))
+            c.score += 2;
+        if (c.score < 3) c.score = 0;   /* a pad with rumble is not a wheel */
+    }
+    if (c.score > best->score) *best = c;
+    return DIENUM_CONTINUE;
+}
+
+static void set_prop_dword(REFGUID prop, DWORD how, DWORD obj, DWORD value)
+{
+    DIPROPDWORD p;
+    p.diph.dwSize = sizeof(DIPROPDWORD);
+    p.diph.dwHeaderSize = sizeof(DIPROPHEADER);
+    p.diph.dwObj = obj;
+    p.diph.dwHow = how;
+    p.dwData = value;
+    IDirectInputDevice8_SetProperty(s_dev, prop, &p.diph);
+}
+
+static void fx_release_all(void);
+
+static void dev_close(const char* why)
+{
+    if (!s_dev) return;
+    fx_release_all();
+    if (s_has_ffb) IDirectInputDevice8_SendForceFeedbackCommand(s_dev, DISFFC_RESET);
+    IDirectInputDevice8_Unacquire(s_dev);
+    IDirectInputDevice8_Release(s_dev);
+    s_dev = NULL;
+    fprintf(stderr, "[wheel] %s: \"%s\" closed\n", why, s_name);
+    WheelInput none; memset(&none, 0, sizeof none); none.hat = -1;
+    publish(&none);
+}
+
+static int dev_open(void)
+{
+    Cand best; memset(&best, 0, sizeof best);
+    best.score = 0;
+    s_enum_count = 0;
+    if (FAILED(IDirectInput8_EnumDevices(s_di, DI8DEVCLASS_GAMECTRL, enum_cb, &best, DIEDFL_ATTACHEDONLY)))
+        return 0;
+    if (s_list && !s_enum_count) fprintf(stderr, "[wheel] DirectInput sees no game controllers\n");
+    s_list = 0;   /* list once */
+    if (!best.score) return 0;
+    if (FAILED(IDirectInput8_CreateDevice(s_di, &best.inst, &s_dev, NULL))) { s_dev = NULL; return 0; }
+    snprintf(s_name, sizeof s_name, "%s", best.name);
+    s_vid = best.vid; s_pid = best.pid;
+    IDirectInputDevice8_SetDataFormat(s_dev, &c_dfDIJoystick2);
+
+    DIDEVCAPS caps; memset(&caps, 0, sizeof caps); caps.dwSize = sizeof caps;
+    IDirectInputDevice8_GetCapabilities(s_dev, &caps);
+    s_has_ffb = (caps.dwFlags & DIDC_FORCEFEEDBACK) && s_gain > 0;
+    /* Effects need exclusive access; a helper window that is never shown is
+     * enough with background access. */
+    if (FAILED(IDirectInputDevice8_SetCooperativeLevel(s_dev, s_hwnd,
+            (s_has_ffb ? DISCL_EXCLUSIVE : DISCL_NONEXCLUSIVE) | DISCL_BACKGROUND))) {
+        s_has_ffb = 0;
+        IDirectInputDevice8_SetCooperativeLevel(s_dev, s_hwnd, DISCL_NONEXCLUSIVE | DISCL_BACKGROUND);
+    }
+    DIPROPRANGE r;
+    r.diph.dwSize = sizeof(DIPROPRANGE);
+    r.diph.dwHeaderSize = sizeof(DIPROPHEADER);
+    r.diph.dwObj = 0;
+    r.diph.dwHow = DIPH_DEVICE;
+    r.lMin = 0; r.lMax = 65535;
+    IDirectInputDevice8_SetProperty(s_dev, DIPROP_RANGE, &r.diph);
+    set_prop_dword(DIPROP_DEADZONE, DIPH_DEVICE, 0, 0);
+    set_prop_dword(DIPROP_SATURATION, DIPH_DEVICE, 0, 10000);
+    if (s_has_ffb) {
+        /* The game centres the wheel itself (the G27's default spring). */
+        set_prop_dword(DIPROP_AUTOCENTER, DIPH_DEVICE, 0, DIPROPAUTOCENTER_OFF);
+        set_prop_dword(DIPROP_FFGAIN, DIPH_DEVICE, 0, (DWORD)s_gain * 100);
+    }
+    IDirectInputDevice8_Acquire(s_dev);
+    if (s_has_ffb) IDirectInputDevice8_SendForceFeedbackCommand(s_dev, DISFFC_RESET);
+
+    /* An axis the wheel doesn't have reads 0, which for a pedal that rests at
+     * the top would be "floored": a two-pedal wheel's missing clutch would hold
+     * the clutch down. Map only what is there. */
+    {
+        static const DWORD ofs[AX_COUNT] = {
+            DIJOFS_X, DIJOFS_Y, DIJOFS_Z, DIJOFS_RX, DIJOFS_RY, DIJOFS_RZ, DIJOFS_SLIDER(0), DIJOFS_SLIDER(1) };
+        for (int a = 0; a < AX_COUNT; a++) {
+            DIDEVICEOBJECTINSTANCEW oi; memset(&oi, 0, sizeof oi); oi.dwSize = sizeof oi;
+            s_axis_present[a] = SUCCEEDED(IDirectInputDevice8_GetObjectInfo(s_dev, &oi, ofs[a], DIPH_BYOFFSET));
+        }
+    }
+    build_map(&s_map, s_vid, s_pid);
+    for (int p = 0; p < 3; p++)
+        if (s_map.pedal[p] >= 0 && !s_axis_present[s_map.pedal[p]]) s_map.pedal[p] = AX_NONE;
+    s_rest_known = 0;
+    s_ffb_dirty = 1;
+    {
+        const char* e = getenv("PS3_WHEEL_RANGE");
+        fprintf(stderr, "[wheel] using \"%s\" (%04X:%04X), force feedback %s, range %s degrees; "
+                        "steer %s, throttle %s, brake %s, clutch %s\n",
+                s_name, s_vid, s_pid, s_has_ffb ? "on" : "off", (e && *e) ? e : "900",
+                k_axis_name[s_map.steer],
+                s_map.pedal[0] >= 0 ? k_axis_name[s_map.pedal[0]] : "none",
+                s_map.pedal[1] >= 0 ? k_axis_name[s_map.pedal[1]] : "none",
+                s_map.pedal[2] >= 0 ? k_axis_name[s_map.pedal[2]] : "none");
+    }
+    return 1;
+}
+
+static LONG axis_val(const DIJOYSTATE2* js, int a)
+{
+    switch (a) {
+    case AX_X:  return js->lX;
+    case AX_Y:  return js->lY;
+    case AX_Z:  return js->lZ;
+    case AX_RX: return js->lRx;
+    case AX_RY: return js->lRy;
+    case AX_RZ: return js->lRz;
+    case AX_S0: return js->rglSlider[0];
+    case AX_S1: return js->rglSlider[1];
+    default:    return 0;
+    }
+}
+
+static float pedal(const DIJOYSTATE2* js, int p)
+{
+    const int a = s_map.pedal[p];
+    if (a < 0) return 0.f;
+    const LONG v = axis_val(js, a);
+    /* Which end is "released": where the pedal rested when the wheel was
+     * opened, if that was clearly one end; otherwise the model's default
+     * (the top, as on Logitech wheels). PS3_WHEEL_PEDALS ...inv flips it. */
+    int high = s_map.pedal_inv[p];
+    const int flip = high == 2;
+    if (high < 0 || flip) {
+        if (s_rest[a] > 58981)     high = 1;
+        else if (s_rest[a] < 6554) high = 0;
+        else                       high = 1;
+        if (flip) high = !high;
+    }
+    float f = high ? (65535.f - (float)v) / 65535.f : (float)v / 65535.f;
+    return f < 0.f ? 0.f : (f > 1.f ? 1.f : f);
+}
+
+static void dev_poll(void)
+{
+    static int fails;
+    DIJOYSTATE2 js;
+    HRESULT hr = IDirectInputDevice8_Poll(s_dev);
+    if (FAILED(hr)) {
+        hr = IDirectInputDevice8_Acquire(s_dev);
+        if (SUCCEEDED(hr)) s_ffb_dirty = 2;   /* effects were dropped with the device */
+    }
+    hr = IDirectInputDevice8_GetDeviceState(s_dev, sizeof js, &js);
+    if (FAILED(hr)) {
+        if (++fails > 1000) { fails = 0; dev_close("lost"); }   /* about a second */
+        return;
+    }
+    fails = 0;
+    if (!s_rest_known) {
+        char line[256]; int n = 0;
+        for (int a = 0; a < AX_COUNT; a++) {
+            s_rest[a] = axis_val(&js, a);
+            if (s_axis_present[a] && n < (int)sizeof line - 24)
+                n += snprintf(line + n, sizeof line - (size_t)n, " %s=%ld", k_axis_name[a], s_rest[a]);
+        }
+        s_rest_known = 1;
+        fprintf(stderr, "[wheel] axes at rest (0-65535):%s\n", n ? line : " none");
+        if (!wheel_trace_on())
+            fprintf(stderr, "[wheel] if a pedal or button is wrong, PS3_WHEEL_TRACE=1 logs them as they move\n");
+    }
+    WheelInput in; memset(&in, 0, sizeof in);
+    in.connected = 1;
+    in.steer = ((float)axis_val(&js, s_map.steer) - 32767.5f) / 32767.5f;
+    in.throttle = pedal(&js, 0);
+    in.brake = pedal(&js, 1);
+    in.clutch = pedal(&js, 2);
+    const DWORD pov = js.rgdwPOV[0];
+    in.hat = (LOWORD(pov) == 0xFFFF) ? -1 : (int)(((pov + 2250) / 4500) % 8);
+    for (int i = 0; i < WHEEL_BTN_COUNT; i++) {
+        const int h = s_map.btn[i];
+        if (h >= 0 && h < 128 && (js.rgbButtons[h] & 0x80)) in.buttons |= 1u << i;
+    }
+    if (in.buttons & (0x7Fu << WHEEL_BTN_GEAR1)) s_shifter_seen = 1;
+    in.shifter = s_shifter_cfg >= 0 ? s_shifter_cfg : s_shifter_seen;
+    publish(&in);
+
+    if (wheel_trace_on()) {
+        static LONG last[AX_COUNT]; static DWORD last_b; static unsigned lines;
+        int moved = 0;
+        for (int a = 0; a < AX_COUNT; a++) if (labs(axis_val(&js, a) - last[a]) > 2000) moved = 1;
+        if ((moved || in.buttons != last_b) && lines < 3000) {
+            lines++;
+            for (int a = 0; a < AX_COUNT; a++) last[a] = axis_val(&js, a);
+            last_b = in.buttons;
+            fprintf(stderr, "[wheel] axes X=%ld Y=%ld Z=%ld RX=%ld RY=%ld RZ=%ld S0=%ld S1=%ld"
+                            " -> steer %.2f thr %.2f brk %.2f clu %.2f btn %06X hat %d\n",
+                    js.lX, js.lY, js.lZ, js.lRx, js.lRy, js.lRz, js.rglSlider[0], js.rglSlider[1],
+                    in.steer, in.throttle, in.brake, in.clutch, (unsigned)in.buttons, in.hat);
+        }
+    }
+}
+
+/* ---------------------------------------------------------------------------
+ * Force feedback: one DirectInput effect per G27 slot, plus the default spring
+ * -------------------------------------------------------------------------*/
+typedef struct {
+    LPDIRECTINPUTEFFECT fx;
+    int         type;
+    int         running;
+    WheelEffect applied;
+} HostFx;
+
+static HostFx s_fx[WHEEL_FFB_SLOTS + 1];
+static int    s_fx_bad[16];   /* a type this wheel refused */
+
+static void fx_release_all(void)
+{
+    for (int i = 0; i <= WHEEL_FFB_SLOTS; i++) {
+        if (s_fx[i].fx) {
+            IDirectInputEffect_Stop(s_fx[i].fx);
+            IDirectInputEffect_Unload(s_fx[i].fx);
+            IDirectInputEffect_Release(s_fx[i].fx);
+        }
+        memset(&s_fx[i], 0, sizeof s_fx[i]);
+    }
+    memset(s_fx_bad, 0, sizeof s_fx_bad);
+}
+
+static const GUID* fx_guid(int type)
+{
+    switch (type) {
+    case WHEEL_FX_CONSTANT: return &GUID_ConstantForce;
+    case WHEEL_FX_SPRING:   return &GUID_Spring;
+    case WHEEL_FX_DAMPER:   return &GUID_Damper;
+    case WHEEL_FX_FRICTION: return &GUID_Friction;
+    case WHEEL_FX_SQUARE:   return &GUID_Square;
+    case WHEEL_FX_SAW_UP:   return &GUID_SawtoothUp;
+    case WHEEL_FX_SAW_DOWN: return &GUID_SawtoothDown;
+    case WHEEL_FX_TRIANGLE: return &GUID_Triangle;
+    default:                return NULL;
+    }
+}
+
+static LONG di_signed(float f) { if (f < -1.f) f = -1.f; if (f > 1.f) f = 1.f; return (LONG)(f * 10000.f); }
+static DWORD di_unsigned(float f) { if (f < 0.f) f = 0.f; if (f > 1.f) f = 1.f; return (DWORD)(f * 10000.f); }
+
+typedef union { DICONSTANTFORCE c; DICONDITION cond; DIPERIODIC p; } FxParams;
+
+static void fx_describe(const WheelEffect* w, DIEFFECT* eff, FxParams* prm, DWORD* axes, LONG* dir)
+{
+    memset(eff, 0, sizeof *eff);
+    memset(prm, 0, sizeof *prm);
+    axes[0] = DIJOFS_X;
+    dir[0] = 0;   /* one axis: the sign of the force is the direction */
+    eff->dwSize = sizeof(DIEFFECT);
+    eff->dwFlags = DIEFF_CARTESIAN | DIEFF_OBJECTOFFSETS;
+    eff->dwDuration = INFINITE;
+    eff->dwGain = DI_FFNOMINALMAX;
+    eff->dwTriggerButton = DIEB_NOTRIGGER;
+    eff->cAxes = 1;
+    eff->rgdwAxes = axes;
+    eff->rglDirection = dir;
+    switch (w->type) {
+    case WHEEL_FX_CONSTANT:
+        prm->c.lMagnitude = di_signed(w->level * s_ffb_sign);
+        eff->cbTypeSpecificParams = sizeof(DICONSTANTFORCE);
+        break;
+    case WHEEL_FX_SPRING:
+    case WHEEL_FX_DAMPER:
+    case WHEEL_FX_FRICTION:
+        prm->cond.lOffset = di_signed(w->center);
+        prm->cond.lPositiveCoefficient = di_signed(w->k_pos);
+        prm->cond.lNegativeCoefficient = di_signed(w->k_neg);
+        prm->cond.dwPositiveSaturation = di_unsigned(w->sat);
+        prm->cond.dwNegativeSaturation = di_unsigned(w->sat);
+        prm->cond.lDeadBand = (LONG)di_unsigned(w->deadband);
+        eff->cbTypeSpecificParams = sizeof(DICONDITION);
+        break;
+    default: {
+        u32 period = w->period_ms;
+        if (period < 4) period = 4;
+        if (period > 2000) period = 2000;
+        prm->p.dwMagnitude = di_unsigned(w->magnitude);
+        prm->p.lOffset = di_signed(w->offset * s_ffb_sign);
+        prm->p.dwPeriod = period * 1000;
+        eff->cbTypeSpecificParams = sizeof(DIPERIODIC);
+        break; }
+    }
+    eff->lpvTypeSpecificParams = prm;
+}
+
+static void fx_sync_one(HostFx* h, const WheelEffect* w, int force)
+{
+    const int on = w->playing && w->type != WHEEL_FX_NONE && !s_fx_bad[w->type & 15];
+    if (!on) {
+        if (h->fx && h->running) { IDirectInputEffect_Stop(h->fx); h->running = 0; }
+        return;
+    }
+    if (h->fx && h->type != w->type) {
+        IDirectInputEffect_Stop(h->fx);
+        IDirectInputEffect_Unload(h->fx);
+        IDirectInputEffect_Release(h->fx);
+        memset(h, 0, sizeof *h);
+    }
+    DIEFFECT eff; FxParams prm; DWORD axes[1]; LONG dir[1];
+    fx_describe(w, &eff, &prm, axes, dir);
+    if (!h->fx) {
+        HRESULT hr = IDirectInputDevice8_CreateEffect(s_dev, fx_guid(w->type), &eff, &h->fx, NULL);
+        if (FAILED(hr) || !h->fx) {
+            h->fx = NULL;
+            if (hr == DIERR_NOTEXCLUSIVEACQUIRED || hr == DIERR_NOTACQUIRED || hr == DIERR_INPUTLOST) {
+                s_ffb_dirty = 2;                     /* not ours right now: try again shortly */
+                s_ffb_retry_at = GetTickCount64() + 100;
+                return;
+            }
+            fprintf(stderr, "[wheel] this wheel refused effect type %d (0x%08lX); skipping it\n",
+                    w->type, (unsigned long)hr);
+            s_fx_bad[w->type & 15] = 1;
+            return;
+        }
+        h->type = w->type;
+        IDirectInputEffect_Start(h->fx, 1, 0);
+        h->running = 1;
+        h->applied = *w;
+        return;
+    }
+    if (force || !h->running || memcmp(&h->applied, w, sizeof *w) != 0) {
+        DWORD flags = DIEP_TYPESPECIFICPARAMS | (h->running && !force ? 0 : DIEP_START);
+        HRESULT hr = IDirectInputEffect_SetParameters(h->fx, &eff, flags);
+        if (FAILED(hr)) {   /* not acquired (another program has the wheel?): try again shortly */
+            s_ffb_dirty = 2;
+            s_ffb_retry_at = GetTickCount64() + 100;
+            return;
+        }
+        h->running = 1;
+        h->applied = *w;
+    }
+}
+
+static void ffb_sync(void)
+{
+    if (s_ffb_retry_at && GetTickCount64() < s_ffb_retry_at) return;
+    s_ffb_retry_at = 0;
+    const LONG d = InterlockedExchange(&s_ffb_dirty, 0);
+    if (!d || !s_has_ffb) return;
+    WheelFfb f;
+    wheel_g27_ffb_snapshot(&f);
+    for (int i = 0; i < WHEEL_FFB_SLOTS; i++) fx_sync_one(&s_fx[i], &f.slot[i], d == 2);
+    WheelEffect ds = f.def_spring;
+    ds.playing = f.def_spring_on;
+    if (!ds.type) ds.type = WHEEL_FX_SPRING;
+    fx_sync_one(&s_fx[WHEEL_FFB_SLOTS], &ds, d == 2);
+}
+
+/* ---------------------------------------------------------------------------
+ * Thread
+ * -------------------------------------------------------------------------*/
+static LRESULT CALLBACK helper_proc(HWND h, UINT m, WPARAM w, LPARAM l) { return DefWindowProcW(h, m, w, l); }
+
+static DWORD WINAPI wheel_thread(LPVOID unused)
+{
+    (void)unused;
+    if (s_mode == MODE_VIRTUAL) {
+        /* For testing the game side: PS3_WHEEL_VIRTUAL=steer=0.5,throttle=1
+         * holds the rim and pedals where it says, from DELAY seconds on. */
+        WheelInput in; memset(&in, 0, sizeof in);
+        in.connected = 1; in.hat = -1; in.shifter = s_shifter_cfg > 0;
+        publish(&in);
+        const char* v = getenv("PS3_WHEEL_VIRTUAL");
+        const char* at;
+        float steer = 0.f, thr = 0.f, brk = 0.f;
+        double delay = 0.;
+        if (v && (at = strstr(v, "steer="))) steer = (float)atof(at + 6);
+        if (v && (at = strstr(v, "throttle="))) thr = (float)atof(at + 9);
+        if (v && (at = strstr(v, "brake="))) brk = (float)atof(at + 6);
+        if (v && (at = strstr(v, "delay="))) delay = atof(at + 6);
+        fprintf(stderr, "[wheel] PS3_WHEEL=virtual: a G27 with no PC wheel behind it (steer %.2f, throttle %.2f, brake %.2f after %.0f s)\n",
+                steer, thr, brk, delay);
+        const ULONGLONG t0 = GetTickCount64();
+        while (!s_stop) {
+            if ((double)(GetTickCount64() - t0) / 1000.0 >= delay) {
+                in.steer = steer; in.throttle = thr; in.brake = brk;
+                publish(&in);
+            }
+            Sleep(50);
+        }
+        return 0;
+    }
+    WNDCLASSEXW wc; memset(&wc, 0, sizeof wc);
+    wc.cbSize = sizeof wc;
+    wc.lpfnWndProc = helper_proc;
+    wc.hInstance = GetModuleHandleW(NULL);
+    wc.lpszClassName = L"ps3recomp_wheel";
+    RegisterClassExW(&wc);
+    s_hwnd = CreateWindowExW(0, wc.lpszClassName, L"", 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, wc.hInstance, NULL);
+    if (FAILED(DirectInput8Create(GetModuleHandleW(NULL), DIRECTINPUT_VERSION, &IID_IDirectInput8W,
+                                  (void**)&s_di, NULL))) {
+        fprintf(stderr, "[wheel] DirectInput is not available; no wheel\n");
+        return 0;
+    }
+    ULONGLONG next_scan = 0;
+    const ULONGLONG t_start = GetTickCount64();
+    int said_none = 0;
+    while (!s_stop) {
+        const ULONGLONG now = GetTickCount64();
+        if (!s_dev && now >= next_scan) {
+            /* A wheel plugged in later is found within a few seconds early on,
+             * within ten later; looking costs a little, on this thread only. */
+            next_scan = now + (now - t_start < 30000 ? 3000 : 10000);
+            if (dev_open()) said_none = 1;
+            else if (!said_none) { said_none = 1; fprintf(stderr, "[wheel] no steering wheel found; still looking every few seconds\n"); }
+        }
+        if (s_dev) {
+            dev_poll();
+            if (s_dev) ffb_sync();
+        }
+        MSG msg;
+        while (PeekMessageW(&msg, NULL, 0, 0, PM_REMOVE)) DispatchMessageW(&msg);
+        Sleep(s_dev ? 1 : 20);
+    }
+    dev_close("shutdown");
+    IDirectInput8_Release(s_di);
+    s_di = NULL;
+    if (s_hwnd) DestroyWindow(s_hwnd);
+    return 0;
+}
+
+int wheel_host_start(void)
+{
+    read_settings();
+    if (s_mode == MODE_OFF) return 0;
+    if (s_started) return 1;
+    s_stop = 0;
+    s_pub.hat = -1;
+    wheel_g27_reset();
+    s_thread = CreateThread(NULL, 256 * 1024, wheel_thread, NULL, 0, NULL);
+    if (!s_thread) return 0;
+    s_started = 1;
+    return 1;
+}
+
+void wheel_host_stop(void)
+{
+    if (!s_started) return;
+    InterlockedExchange(&s_stop, 1);
+    WaitForSingleObject(s_thread, 3000);
+    CloseHandle(s_thread);
+    s_thread = NULL;
+    s_started = 0;
+}
+
+#else  /* !_WIN32: no host wheel yet */
+
+int  wheel_host_start(void) { return 0; }
+void wheel_host_stop(void) {}
+int  wheel_host_read(WheelInput* out) { memset(out, 0, sizeof *out); out->hat = -1; return 0; }
+void wheel_host_ffb_changed(void) {}
+
+#endif
