+static int ld_vc_enabled(void)
+{
+    if (s_vc_on < 0) {
+        const char* e = getenv("LD_VCACHE");
+        s_vc_on = !(e && atoi(e) == 0);
+        if (s_vc_on) {
+            s_vc = (ld_vc_entry*)calloc(LD_VC_SLOTS, sizeof(ld_vc_entry));
+            const char* m = getenv("LD_VCACHE_MB");
+            s_vc_size = (u64)(m ? atoi(m) : 384) << 20;
+            if (!s_vc || s_vc_size < (16u << 20)) s_vc_on = 0;
