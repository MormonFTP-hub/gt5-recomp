+    st_new.press_left     = (btns & CELL_PAD_CTRL_LEFT)     ? 255 : 0;
+    st_new.press_right    = (btns & CELL_PAD_CTRL_RIGHT)    ? 255 : 0;
+    st_new.press_triangle = (btns & CELL_PAD_CTRL_TRIANGLE) ? 255 : 0;
+    st_new.press_circle   = (btns & CELL_PAD_CTRL_CIRCLE)   ? 255 : 0;
+    st_new.press_cross    = (btns & CELL_PAD_CTRL_CROSS)    ? 255 : 0;
+    st_new.press_square   = (btns & CELL_PAD_CTRL_SQUARE)   ? 255 : 0;
+    st_new.press_l1       = (btns & CELL_PAD_CTRL_L1)       ? 255 : 0;
+    st_new.press_r1       = (btns & CELL_PAD_CTRL_R1)       ? 255 : 0;
