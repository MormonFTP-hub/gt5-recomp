+typedef struct { char name[64]; u8* data; u32 size; } shader_mem_file;
+static shader_mem_file* s_smf;
+static volatile LONG s_smf_next;
+static LONG s_smf_n;
+static DWORD WINAPI shader_mem_reader(LPVOID unused)
+{
+    (void)unused;
+    char path[MAX_PATH];
+    for (;;) {
+        const LONG i = InterlockedIncrement(&s_smf_next) - 1;
+        if (i >= s_smf_n) return 0;
+        snprintf(path, sizeof path, "%s\\%s", g_ld_shader_disk_dir, s_smf[i].name);
+        FILE* f = fopen(path, "rb");
+        if (!f) continue;
+        if (fseek(f, 0, SEEK_END) == 0) {
+            const long n = ftell(f);
+            if (n > 0 && n < 8L * 1024L * 1024L && fseek(f, 0, SEEK_SET) == 0) {
+                u8* d = (u8*)malloc((size_t)n);
+                if (d && fread(d, 1, (size_t)n, f) == (size_t)n) { s_smf[i].data = d; s_smf[i].size = (u32)n; }
+                else free(d);
+            }
+        }
+        fclose(f);
