+/* 1: none of the entry's pages written since its generation; 0: written; -1: cannot tell. */
+static int ld_vc_clean(const ld_vc_entry* e)
+{
+    for (u32 i = 0; i < e->n_spans; i++)
+        if (!ld_vc_harvest(e->lo[i], e->hi[i])) { ld_vc_fail(5, e->lo[i]); return -1; }
+    for (u32 i = 0; i < e->n_spans; i++)
+        for (const u8* pg = e->lo[i]; pg < e->hi[i]; pg += 4096)
+            if (s_vc_page_gen[(u32)((pg - vm_base) >> 12)] > e->gen) return 0;
+    return 1;
+}
