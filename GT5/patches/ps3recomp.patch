+    bars[0].Transition.StateBefore = D3D12_RESOURCE_STATE_DEPTH_WRITE;
+    bars[0].Transition.StateAfter = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
