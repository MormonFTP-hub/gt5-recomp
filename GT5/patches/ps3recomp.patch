+/* The guest pages this draw read: its index ranges and each fetched attribute's span, page-aligned,
+ * merged, at most LD_VC_SPANS of them, harvested. 0 when they cannot be named or tracked. */
+static int ld_vc_record(ld_vc_entry* e)
+{
+    /* One span for the index array (its batches, up to 256 of them, read one array) plus one per
+     * attribute: at most 17. */
+    const u8* lo[RSX_DSP_NUM_VERTEX_ATTR + 1]; const u8* hi[RSX_DSP_NUM_VERTEX_ATTR + 1]; u32 n = 0;
+    if (dc.n_idx) {
+        rsx_dsp_index_array ia; rsx_dsp_get_index_array(&g.rsx, &ia);
+        const u32 es = ia.is_u32 ? 4u : 2u;
