+/* What the open command list was last given, so a draw that sets the same heaps, root signature,
+ * pipeline, topology, viewport or scissor as the one before skips the driver call. Every call of
+ * these kinds goes through here, and a list reset forgets it all. */
+static struct {
+    int heaps; ID3D12DescriptorHeap* h0; ID3D12DescriptorHeap* h1;
+    ID3D12RootSignature* rs; ID3D12PipelineState* pso;
+    int topo_ok; D3D12_PRIMITIVE_TOPOLOGY topo;
+    int vp_ok; D3D12_VIEWPORT vp; int sc_ok; D3D12_RECT sc;
