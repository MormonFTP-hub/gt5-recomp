+/* With Steam open, its desktop layout makes this pad a mouse and keyboard for anything that isn't a
+ * Steam game: R2 left click, L2 right click, right stick moves the cursor, Cross presses Enter. A
+ * trigger press with the cursor outside the window clicks whatever is there, the window loses focus
+ * and the pad stops counting, in the middle of a corner. So while the pad is in use the cursor stays
+ * on the picture, and five seconds after its last use the mouse is free again. PAD_NO_CURSOR_GUARD off.
+ *
+ * That clip held the user's own mouse too, for whole races: a right stick held up for throttle
+ * counts as use. So by default nothing is clipped. Steam's mouse comes in through SendInput, which
+ * marks every event injected; a low-level mouse hook drops injected mouse events while the pad has
+ * been used in the last five seconds and this game's window is in front, and lets everything else
+ * through. The real mouse moves and clicks freely. PAD_CURSOR_CLIP=1 clips as before. */
+static unsigned long long pad_now_ms(void);
+static volatile LONG64 s_pad_last_use_tick;      /* GetTickCount64 at the pad's last use, 0 = never */
+static volatile LONG s_pad_mouse_hook, s_pad_mouse_dropped;
+static LRESULT CALLBACK pad_mouse_ll(int code, WPARAM wp, LPARAM lp)
+{
+    if (code == HC_ACTION) {
+        const MSLLHOOKSTRUCT* m = (const MSLLHOOKSTRUCT*)lp;
+        const LONG64 last = s_pad_last_use_tick;
+        if ((m->flags & (LLMHF_INJECTED | LLMHF_LOWER_IL_INJECTED)) && last &&
+            GetTickCount64() - (ULONGLONG)last < 5000) {
+            HWND fg = GetForegroundWindow();
+            DWORD pid = 0;
+            if (fg) GetWindowThreadProcessId(fg, &pid);
+            if (pid == GetCurrentProcessId()) {
+                InterlockedIncrement(&s_pad_mouse_dropped);
+                return 1;
+            }
+        }
+    }
+    return CallNextHookEx(NULL, code, wp, lp);
+}
+static DWORD WINAPI pad_mouse_hook_thread(LPVOID unused)
+{
+    (void)unused;
+    /* Every mouse event on the desktop waits for this hook, so it must never wait for a busy game:
+     * a hook that misses Windows' timeout lags the user's whole mouse. Its work is a few compares. */
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_TIME_CRITICAL);
+    HHOOK h = SetWindowsHookExW(WH_MOUSE_LL, pad_mouse_ll, GetModuleHandleW(NULL), 0);
+    if (!h) {
+        fprintf(stderr, "[pad] mouse hook not installed (error %lu); Steam's pad mouse is not filtered\n", GetLastError());
+        return 0;
+    }
+    fprintf(stderr, "[pad] the mouse is never held; Steam's pad-driven mouse is ignored while the pad drives the game\n");
+    MSG msg;
+    while (GetMessageW(&msg, NULL, 0, 0) > 0) {}
+    UnhookWindowsHookEx(h);
+    return 0;
+}
+static void pad_cursor_guard(const PadHostState* hs)
+{
+    static int mode = -1, clipped;   /* 0 off, 1 drop injected mouse input, 2 clip the cursor */
+    static unsigned long long last_use, last_clip;
+    if (mode < 0) mode = getenv("PAD_NO_CURSOR_GUARD") ? 0 : getenv("PAD_CURSOR_CLIP") ? 2 : 1;
+    if (!mode) return;
+    const unsigned long long now = pad_now_ms();
+    if (hs && (hs->buttons || hs->trigger_l2 > 16 || hs->trigger_r2 > 16 ||
+               abs((int)hs->analog_lx - 128) > 48 || abs((int)hs->analog_ly - 128) > 48 ||
+               abs((int)hs->analog_rx - 128) > 48 || abs((int)hs->analog_ry - 128) > 48))
+        last_use = now;
+    if (mode == 1) {
+        if (!hs) return;
+        if (last_use == now) s_pad_last_use_tick = (LONG64)GetTickCount64();
+        if (!InterlockedCompareExchange(&s_pad_mouse_hook, 1, 0)) {
+            HANDLE t = CreateThread(NULL, 64 * 1024, pad_mouse_hook_thread, NULL, 0, NULL);
+            if (t) CloseHandle(t);
+        }
+        return;
+    }
+    if (hs && last_use && now - last_use < 5000) {
+        if (clipped && now - last_clip < 250) return;
+        HWND fg = GetForegroundWindow();
+        RECT r; POINT o = { 0, 0 };
+        if (fg && GetClientRect(fg, &r) && ClientToScreen(fg, &o) && r.right > 0 && r.bottom > 0) {
+            OffsetRect(&r, o.x, o.y);
+            ClipCursor(&r);
+            clipped = 1; last_clip = now;
+        }
+    } else if (clipped) {
+        ClipCursor(NULL);
+        clipped = 0;
+    }
+}
