+        for (u32 bi = 0; bi < dc.n_idx; bi++) {
+            const u64 start = (u64)ia.offset + (u64)dc.idx[bi].first * es, bytes = (u64)dc.idx[bi].count * es;
+            if (!bytes) continue;
