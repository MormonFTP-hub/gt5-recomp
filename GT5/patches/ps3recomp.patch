+/* ---------------------------------------------------------------------------
+ * ATRAC3plus
+ * -----------------------------------------------------------------------*/
+#ifdef PS3RECOMP_FFMPEG_RUNTIME
+
+static void atrac_close(AdecSlot* a)
+{
+    if (!a->ff) return;
+    if (a->av) a->ff->avcodec_free_context(&a->av);
+    if (a->pkt) a->ff->av_packet_free(&a->pkt);
+    if (a->frame) a->ff->av_frame_free(&a->frame);
+}
+
+/* The stream's channels, from the ATRAC3plus channel configuration index. */
+static int atrac_stream_channels(u32 cfg)
+{
+    static const unsigned char n[8] = { 0, 1, 2, 3, 4, 6, 7, 8 };
+    return cfg < 8 && n[cfg] ? n[cfg] : 2;
+}
+
+static int atrac_open(AdecSlot* a)
+{
+    atrac_close(a);
+    a->ff = ps3_ffmpeg_get();
+    if (!a->ff) return 0;
+    const AVCodec* c = a->ff->avcodec_find_decoder(AV_CODEC_ID_ATRAC3P);
+    if (!c) return 0;
+    a->av = a->ff->avcodec_alloc_context3(c);
+    a->pkt = a->ff->av_packet_alloc();
+    a->frame = a->ff->av_frame_alloc();
+    if (!a->av || !a->pkt || !a->frame) return 0;
+    a->av->ch_layout.order = AV_CHANNEL_ORDER_UNSPEC;
+    a->av->ch_layout.nb_channels = atrac_stream_channels(a->chConfig);
+    a->av->sample_rate = (int)a->sampleRate;
+    a->av->block_align = (int)a->nbytes;
+    if (a->ff->avcodec_open2(a->av, c, NULL) < 0) {
+        a->ff->avcodec_free_context(&a->av);
+        return 0;
+    }
+    return 1;
+}
+
+/* Write a decoded frame into a slot's PCM area, big-endian, interleaved. Returns the size. */
+static u32 atrac_store(const AdecSlot* a, const AVFrame* f, u32 pcm_ea)
+{
+    const u32 nch = a->nchOut ? a->nchOut : (u32)f->ch_layout.nb_channels;
+    const u32 samples = (u32)f->nb_samples > 2048u ? 2048u : (u32)f->nb_samples;
+    const u32 have = (u32)f->ch_layout.nb_channels;
+    u8* out = vm_base + pcm_ea;
+    const u32 bytes = a->wordFmt == ATX_WORD_16BIT ? 2u : a->wordFmt == ATX_WORD_24BIT ? 3u : 4u;
+    for (u32 s = 0; s < samples; s++) {
+        for (u32 c = 0; c < nch && c < 8; c++) {
+            const float v = c < have ? ((const float*)f->extended_data[c])[s] : 0.0f;
+            u32 w;
+            if (a->wordFmt == ATX_WORD_FLOAT || !a->wordFmt) {
+                memcpy(&w, &v, 4);
+            } else {
+                const float k = v > 1.0f ? 1.0f : v < -1.0f ? -1.0f : v;
+                w = (u32)(s32)(k * (a->wordFmt == ATX_WORD_16BIT ? 32767.0f : a->wordFmt == ATX_WORD_24BIT ? 8388607.0f : 2147483647.0f));
+            }
+            for (u32 b = 0; b < bytes; b++)
+                out[b] = (u8)(w >> (8 * (bytes - 1 - b)));
+            out += bytes;
+        }
+    }
+    return samples * nch * bytes;
+}
+
+/* Decode one access unit; 1 and its size if a block came out. */
+static int atrac_decode(AdecSlot* a, u32 addr, u32 size, u32 pcm_ea, u32* pcm_size)
+{
+    const u8* p = vm_base + addr;
+    /* The 8-byte ATS header, if the demuxer left it on: sync 0FD0, then 3 bits of sample rate,
+     * 3 of channel configuration and 10 of frame size. A title can leave all of them out of
+     * cellAdecStartSeq (GT5 passes 0 for both) and the decoder takes them from here. */
+    if (size >= 8 && p[0] == 0x0F && p[1] == 0xD0) {
+        static const u32 rates[8] = { 32000, 44100, 48000, 88200, 96000, 48000, 48000, 48000 };
+        const u32 v = (u32)p[2] << 8 | p[3];
+        const u32 cfg = v >> 10 & 7, nbytes = ((v & 0x3FF) + 1) * 8, rate = rates[v >> 13];
+        if (!a->av || cfg != a->chConfig || nbytes != a->nbytes || rate != a->sampleRate) {
+            a->chConfig = cfg;
+            a->nbytes = nbytes;
+            a->sampleRate = rate;
+            const int ok = atrac_open(a);
+            fprintf(stderr, "[cellAdec] ATRAC3plus stream %u Hz cfg=%u nbytes=%u decoder=%d%c", rate, cfg, nbytes, ok, 10);
+        }
+        p += 8;
+        size -= 8;
+    }
+    if (!a->av) return 0;
+    /* The decoder reads past the end of a packet, so it can't see guest memory directly. */
+    u8* copy = (u8*)malloc(size + AV_INPUT_BUFFER_PADDING_SIZE);
+    if (!copy) return 0;
+    memcpy(copy, p, size);
+    memset(copy + size, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    a->pkt->data = copy;
+    a->pkt->size = (int)size;
+    int got = 0;
+    if (a->ff->avcodec_send_packet(a->av, a->pkt) >= 0) {
+        while (a->ff->avcodec_receive_frame(a->av, a->frame) >= 0) {
+            *pcm_size = atrac_store(a, a->frame, pcm_ea);
+            got = 1;
+            a->ff->av_frame_unref(a->frame);
+        }
+    }
+    a->pkt->data = NULL;
+    a->pkt->size = 0;
+    free(copy);
+    return got;
+}
+#endif
