+    hr = g.dev->lpVtbl->CreateComputePipelineState(
+        g.dev, &pipeline, &IID_ID3D12PipelineState,
+        (void**)&g.stencil_snapshot_pso);
+    shader->lpVtbl->Release(shader);
+    return SUCCEEDED(hr) ? 0 : -1;
