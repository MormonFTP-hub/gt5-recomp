+/* Vertex conversion on several cores. A race frame converts about a million vertices into
+ * float4 attributes on the RSX thread. rsx_vertex_fetch_many does it an attribute at a time
+ * (the same bytes as fetch_one per vertex: tests/test_vertex_fetch_plan.c) and only reads the
+ * plan and guest memory, so a big draw is cut into chunks that workers and this thread take in
+ * turn. The job is tagged with a generation so a worker that wakes late can never count a chunk
+ * twice. LD_VERTEX_THREADS=<n> workers (default 6, 0 = this thread only). */
+#define LD_VP_CHUNK 2048u
+#define LD_VP_MIN   4096u
+static struct { const rsx_vertex_fetch_plan* plan; const rsx_vertex_ref* refs; u8* out; u32 stride, count, nchunks; } s_vp;
+static volatile LONG64 s_vp_ctr;        /* generation << 32 | next chunk */
+static volatile LONG s_vp_done, s_vp_fail;
+static HANDLE s_vp_sem;
+static int s_vp_workers = -1;
+LONGLONG g_vx_pub[3];
+unsigned long long g_vx_pub_n[2];
+#define g_vx_gather g_vx_pub[0]
+#define g_vx_remap g_vx_pub[1]
+#define g_vx_fetch g_vx_pub[2]
+#define g_vx_verts g_vx_pub_n[0]
+#define g_vx_par_verts g_vx_pub_n[1]
+static void ld_vp_run(void)
+{
+    for (;;) {
+        const LONG64 v = InterlockedIncrement64(&s_vp_ctr) - 1;
+        const u32 c = (u32)(v & 0xFFFFFFFF);
+        if (c >= s_vp.nchunks) return;
+        const u32 i0 = c * LD_VP_CHUNK;
+        const u32 n = s_vp.count - i0 < LD_VP_CHUNK ? s_vp.count - i0 : LD_VP_CHUNK;
+        if (!rsx_vertex_fetch_many(s_vp.plan, s_vp.refs + i0, n, s_vp.out + (size_t)i0 * s_vp.stride))
+            InterlockedExchange(&s_vp_fail, 1);
+        InterlockedIncrement(&s_vp_done);
+    }
+}
+static DWORD WINAPI ld_vp_worker(LPVOID unused)
+{
+    (void)unused;
+    for (;;) { WaitForSingleObject(s_vp_sem, INFINITE); ld_vp_run(); }
+}
+static int ld_fetch_vertices(const rsx_vertex_fetch_plan* plan, const rsx_vertex_ref* refs, u32 count, u8* out)
+{
+    if (s_vp_workers < 0) {
+        const char* e = getenv("LD_VERTEX_THREADS");
+        s_vp_workers = e ? atoi(e) : 6;
+        if (s_vp_workers > 16) s_vp_workers = 16;
+        if (s_vp_workers > 0) {
+            s_vp_sem = CreateSemaphoreA(NULL, 0, 1 << 20, NULL);
+            int started = 0;
+            for (int i = 0; s_vp_sem && i < s_vp_workers; i++) {
+                HANDLE t = CreateThread(NULL, 256 * 1024, ld_vp_worker, NULL, 0, NULL);
+                if (t) { CloseHandle(t); started++; }
+            }
+            s_vp_workers = started;
+        }
+        fprintf(stderr, "[vertex] conversion on %d worker thread(s) plus the RSX thread\n", s_vp_workers);
+    }
+    g_vx_verts += count;
+    if (count < LD_VP_MIN || s_vp_workers <= 0 || !plan->layout.stride)
+        return rsx_vertex_fetch_many(plan, refs, count, out);
+    g_vx_par_verts += count;
+    s_vp.plan = plan; s_vp.refs = refs; s_vp.out = out;
+    s_vp.stride = plan->layout.stride; s_vp.count = count;
+    s_vp.nchunks = (count + LD_VP_CHUNK - 1) / LD_VP_CHUNK;
+    s_vp_done = 0; s_vp_fail = 0;
+    const LONG64 gen = (s_vp_ctr >> 32) + 1;
+    InterlockedExchange64(&s_vp_ctr, gen << 32);
+    const LONG wake = (LONG)(s_vp.nchunks - 1 < (u32)s_vp_workers ? s_vp.nchunks - 1 : (u32)s_vp_workers);
+    if (wake > 0) ReleaseSemaphore(s_vp_sem, wake, NULL);
+    ld_vp_run();
+    while ((u32)InterlockedCompareExchange(&s_vp_done, 0, 0) < s_vp.nchunks) YieldProcessor();
+    /* Park the counter past the end, so a worker waking now finds nothing to take. */
+    InterlockedExchange64(&s_vp_ctr, (gen << 32) | 0x80000000);
+    return !s_vp_fail;
+}
