diff --git a/libs/video/display_aspect.c b/libs/video/display_aspect.c
new file mode 100644
index 00000000..6aa79ae2
--- /dev/null
+++ b/libs/video/display_aspect.c
@@ -0,0 +1,140 @@
+/*
+ * ps3recomp - display aspect for screens wider than 16:9 (see display_aspect.h)
+ */
+#include "display_aspect.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <math.h>
+
+#ifdef _WIN32
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#endif
+
+#define ASPECT_16_9 (16.0f / 9.0f)
+
+static int   s_init;
+static float s_asked = ASPECT_16_9;   /* PS3_ASPECT / PS3_WINDOW_SIZE */
+static const char* s_asked_from = "default";
+static int   s_title_widens;          /* ps3_display_title_widens() was called */
+static u32   s_win_w, s_win_h;   /* PS3_WINDOW_SIZE, 0 when not set */
+
+/* "21:9", "2560x1080", "2.37": width over height, 0 when it isn't one of those. */
+static float parse_shape(const char* s)
+{
+    char* e;
+    const double a = strtod(s, &e);
+    if (e == s || a <= 0.0) return 0.0f;
+    if (*e == ':' || *e == 'x' || *e == 'X') {
+        const double b = strtod(e + 1, NULL);
+        return b > 0.0 ? (float)(a / b) : 0.0f;
+    }
+    return (float)a;
+}
+
+static int same_word(const char* a, const char* b)
+{
+    for (; *a && *b; a++, b++) {
+        const char x = (char)(*a | 0x20), y = (char)(*b | 0x20);
+        if (x != y) return 0;
+    }
+    return *a == *b;
+}
+
+static float monitor_shape(void)
+{
+#ifdef _WIN32
+    POINT pt = {0, 0};
+    MONITORINFO mi;
+    memset(&mi, 0, sizeof mi);
+    mi.cbSize = sizeof mi;
+    if (GetMonitorInfoA(MonitorFromPoint(pt, MONITOR_DEFAULTTOPRIMARY), &mi)) {
+        const LONG w = mi.rcMonitor.right - mi.rcMonitor.left;
+        const LONG h = mi.rcMonitor.bottom - mi.rcMonitor.top;
+        if (w > 0 && h > 0) return (float)w / (float)h;
+    }
+#endif
+    return ASPECT_16_9;
+}
+
+static void display_init(void)
+{
+    if (s_init) return;
+    s_init = 1;
+    const char* ws = getenv("PS3_WINDOW_SIZE");
+    if (ws && *ws) {
+        unsigned w = 0, h = 0;
+        if (sscanf(ws, "%ux%u", &w, &h) == 2 && w >= 64 && h >= 64 && w <= 16384 && h <= 16384) {
+            s_win_w = w; s_win_h = h;
+        }
+    }
+    const char* as = getenv("PS3_ASPECT");
+    float a = ASPECT_16_9;
+    const char* from = "default";
+    if (as && *as) {
+        if (same_word(as, "auto")) { a = monitor_shape(); from = "monitor"; }
+        else if (same_word(as, "off")) { a = ASPECT_16_9; from = "PS3_ASPECT"; }
+        else { const float p = parse_shape(as); if (p > 0.0f) a = p; from = "PS3_ASPECT"; }
+    } else if (s_win_w) {
+        a = (float)s_win_w / (float)s_win_h;
+        from = "PS3_WINDOW_SIZE";
+    }
+    /* Narrower than 16:9 stays 16:9; past 4:1 nothing reads well. */
+    if (a < ASPECT_16_9 * 1.005f) a = ASPECT_16_9;
+    if (a > 4.0f) a = 4.0f;
+    s_asked = a;
+    s_asked_from = from;
+}
+
+/* What is in force: the asked shape once the title said it can draw it, else 16:9. */
+static float shape(void)
+{
+    display_init();
+    return s_title_widens ? s_asked : ASPECT_16_9;
+}
+
+void ps3_display_title_widens(void)
+{
+    display_init();
+    s_title_widens = 1;
+    if (s_asked != ASPECT_16_9)
+        fprintf(stderr, "[display] shape %.4f (%s), wider than 16:9\n", s_asked, s_asked_from);
+}
+
+float ps3_display_aspect(void) { return shape(); }
+int   ps3_display_wide(void)   { return shape() != ASPECT_16_9; }
+float ps3_display_widen(void)  { return shape() / ASPECT_16_9; }
+
+void ps3_display_render_size(u32 base_w, u32 base_h, u32* w, u32* h)
+{
+    const float a = shape();
+    u32 rw = base_w;
+    if (a != ASPECT_16_9) {
+        rw = ((u32)lroundf((float)base_h * a / 8.0f)) * 8u;
+        if (rw > PS3_DISPLAY_MAX_W) rw = PS3_DISPLAY_MAX_W;
+        if (rw < base_w) rw = base_w;
+    }
+    *w = rw;
+    *h = base_h;
+}
+
+void ps3_display_window_size(u32 render_w, u32 render_h, u32* client_w, u32* client_h)
+{
+    const float a = shape();
+    if (s_asked != ASPECT_16_9 && !s_title_widens) {
+        static int said;
+        if (!said) {
+            said = 1;
+            fprintf(stderr, "[display] shape %.4f asked (%s), but this title can't draw wider than 16:9:"
+                            " the picture stays 16:9\n", s_asked, s_asked_from);
+        }
+    }
+    u32 w = render_w, h = render_h;
+    if (s_win_w) { w = s_win_w; h = s_win_h; }
+    else if (a != ASPECT_16_9) w = (u32)lroundf((float)render_h * a);
+    *client_w = w;
+    *client_h = h;
+}
diff --git a/libs/video/display_aspect.h b/libs/video/display_aspect.h
new file mode 100644
index 00000000..ba2f762a
--- /dev/null
+++ b/libs/video/display_aspect.h
@@ -0,0 +1,55 @@
+/*
+ * ps3recomp - display aspect for screens wider than 16:9 (ultrawide)
+ *
+ * A PS3 title draws for a 16:9 television. On a wider PC screen the picture can either be
+ * shown at 16:9 (today's default) or widened, which needs the title's own camera widened
+ * (a title-side change) and the picture shown across the wider window. This module only
+ * decides the shape; the title and the renderer ask it.
+ *
+ *   PS3_ASPECT=auto          the shape of the monitor the window opens on
+ *   PS3_ASPECT=21:9 | 2560x1080 | 2.37   an explicit shape
+ *   PS3_ASPECT=16:9 | off    as on a PS3 (also the default)
+ *   PS3_WINDOW_SIZE=<w>x<h>  the window's drawing area in pixels; when PS3_ASPECT is not set,
+ *                            the shape follows it (how tests force a 2560x1080 window)
+ *
+ * Shapes narrower than 16:9 (16:10, 4:3) are left as they are: 16:9.
+ */
+#ifndef PS3RECOMP_DISPLAY_ASPECT_H
+#define PS3RECOMP_DISPLAY_ASPECT_H
+
+#include "ps3emu/ps3types.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* A title that can draw wider than 16:9 says so before anything asks for the shape (GT5 does in
+ * src/gt5_widescreen.cpp, run right after its executable is loaded). Without that the shape
+ * stays 16:9 whatever was asked: a title that draws 16:9 into a wider frame would come out
+ * stretched. */
+void ps3_display_title_widens(void);
+
+/* Width / height of the picture: 16/9 unless a wider shape was asked for and the title can. */
+float ps3_display_aspect(void);
+
+/* 1 when the picture is wider than 16:9 (by more than 0.5%), else 0. */
+int ps3_display_wide(void);
+
+/* How much wider than 16:9 the picture is: ps3_display_aspect() / (16/9), 1.0 when not wide. */
+float ps3_display_widen(void);
+
+/* The size a title's frame should have for a base_w x base_h video mode (1280x720): that size at
+ * 16:9; when wide, base_h lines at the wide shape (a multiple of 8 across), at most
+ * PS3_DISPLAY_MAX_W across. Past that the frame keeps that width and the window stretches it. */
+#define PS3_DISPLAY_MAX_W 1920u
+void ps3_display_render_size(u32 base_w, u32 base_h, u32* w, u32* h);
+
+/* The window's drawing area for a title rendering render_w x render_h: that size unless
+ * PS3_WINDOW_SIZE says otherwise or the picture is wide (then render_h lines at the wide shape). */
+void ps3_display_window_size(u32 render_w, u32 render_h, u32* client_w, u32* client_h);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
