+static HANDLE ds_open(int* is_dualsense)
+{
+    static HMODULE hid, setup;
+    if (!hid) hid = LoadLibraryA("hid.dll");
+    if (!setup) setup = LoadLibraryA("setupapi.dll");
+    if (!hid || !setup) return INVALID_HANDLE_VALUE;
+    void (WINAPI *get_guid)(GUID*) = (void (WINAPI*)(GUID*))(void*)GetProcAddress(hid, "HidD_GetHidGuid");
+    BOOLEAN (WINAPI *get_attrs)(HANDLE, ds_hid_attrs*) = (BOOLEAN (WINAPI*)(HANDLE, ds_hid_attrs*))(void*)GetProcAddress(hid, "HidD_GetAttributes");
+    void* (WINAPI *get_devs)(const GUID*, const WCHAR*, HWND, DWORD) = (void* (WINAPI*)(const GUID*, const WCHAR*, HWND, DWORD))(void*)GetProcAddress(setup, "SetupDiGetClassDevsW");
+    BOOL (WINAPI *enum_ifaces)(void*, void*, const GUID*, DWORD, ds_iface_data*) = (BOOL (WINAPI*)(void*, void*, const GUID*, DWORD, ds_iface_data*))(void*)GetProcAddress(setup, "SetupDiEnumDeviceInterfaces");
+    BOOL (WINAPI *get_detail)(void*, ds_iface_data*, ds_iface_detail*, DWORD, DWORD*, void*) = (BOOL (WINAPI*)(void*, ds_iface_data*, ds_iface_detail*, DWORD, DWORD*, void*))(void*)GetProcAddress(setup, "SetupDiGetDeviceInterfaceDetailW");
+    BOOL (WINAPI *destroy)(void*) = (BOOL (WINAPI*)(void*))(void*)GetProcAddress(setup, "SetupDiDestroyDeviceInfoList");
+    if (!get_guid || !get_attrs || !get_devs || !enum_ifaces || !get_detail || !destroy) return INVALID_HANDLE_VALUE;
+    GUID guid;
+    get_guid(&guid);
+    void* devs = get_devs(&guid, NULL, NULL, 0x12 /* DIGCF_PRESENT | DIGCF_DEVICEINTERFACE */);
+    if (devs == INVALID_HANDLE_VALUE) return INVALID_HANDLE_VALUE;
+    HANDLE found = INVALID_HANDLE_VALUE;
+    ds_iface_data id;
+    id.cbSize = sizeof id;
+    for (DWORD i = 0; found == INVALID_HANDLE_VALUE && enum_ifaces(devs, NULL, &guid, i, &id); i++) {
