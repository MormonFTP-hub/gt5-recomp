+        bars[1].Transition.pResource = z->stencil_snap;
+        bars[1].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
+        bars[1].Transition.StateBefore = z->stencil_state;
+        bars[1].Transition.StateAfter = D3D12_RESOURCE_STATE_UNORDERED_ACCESS;
+        nbar = 2;
+    }
+    g.list->lpVtbl->ResourceBarrier(g.list, nbar, bars);
