+/* ---- LD_VCACHE: converted draws kept across frames -------------------------------------------
+ * GT5 draws the same car and track meshes every frame from memory nothing rewrites, and each draw
+ * used to gather its indices, de-duplicate them and convert every vertex again (4.5 ms a frame,
+ * plus 0.9 ms copying into the ring). Here a draw's result -- its float vertices and its triangle
+ * list -- is kept in a GPU-visible arena, keyed by everything that decides it (the index and vertex
+ * array registers, the attributes the program reads, their defaults), and reused while the guest
+ * pages it was read from are unwritten. Windows write tracking (MEM_WRITE_WATCH on the guest
+ * reservation, vm.h) says whether they were: a query is about a microsecond, where converting a
+ * draw averaged five. This is the same idea as Xenia's and RPCS3's page watches, without faults.
+ *
+ * A key's pages are reset first and its data read afterwards, so a write can never slip between
+ * the read and the reset: a new key records its pages and resets them, the next sighting with
+ * those pages still clean converts and stores, and later ones draw from the store. A key whose
+ * pages keep being written (dynamic geometry) is left to the ordinary path after two strikes.
+ * LD_VCACHE=0 turns it off; LD_VCACHE_MB sizes the arena (default 384). */
+#define LD_VC_SLOTS 16384u
+#define LD_VC_SPANS 4u
+typedef struct {
+    u32 prim, mask, n_arr, n_idx, idx_loc, idx_off, idx_u32, restart, restart_value, base_index,
+        base_offset, divider;
+    batch_t first;     /* the first batch, the total count, and a hash of the whole batch list: */
+    u32 total;         /* NV4097 caps a batch at 256 indices, so a mesh is usually dozens of them */
+    u64 batches_hash;
+    struct { rsx_dsp_vertex_attr d; float def[4]; } a[16];
+} ld_vc_key;
+typedef struct {
+    u64 h;
+    ld_vc_key k;
+    u8 state;      /* 0 empty, 1 pages recorded, 2 stored, 3 left alone */
+    u8 strikes, indexed, n_spans;
+    u32 gen;       /* the write generation its pages were last known clean at */
+    u32 last_frame;   /* last frame it was looked up: the oldest one in a crowded run is replaced */
+    u32 vb_off, n_verts, ib_off, n_index;
+    const u8* lo[LD_VC_SPANS];
+    const u8* hi[LD_VC_SPANS];
+} ld_vc_entry;
+static ld_vc_entry* s_vc;
+static ID3D12Resource* s_vc_buf;
+static u8* s_vc_mapped;
+static u64 s_vc_size, s_vc_used;
+static int s_vc_on = -1;
+unsigned long long g_vc_stat[8];   /* hit, stored, recorded, dirty, left alone, unkeyable, wipes, failed */
+unsigned long long g_vc_why[6];    /* record failed: index ptr, attr not contiguous, no pages, too spread, reset failed, query failed */
+extern uint8_t* vm_base;
+static void ld_vc_fail(int why, const void* at)
+{
+    g_vc_why[why]++;
+    static int n;
+    if (n < 6) { n++; fprintf(stderr, "[vcache] cannot track a draw: reason %d at %p (guest base %p) err=%lu\n",
+                             why, at, (void*)vm_base, (unsigned long)GetLastError()); }
+}
