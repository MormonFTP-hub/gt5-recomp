+/* Readbacks into guest memory recorded in the open list (rsx_live_draw_read_rect). */
+#define LD_GUEST_READS 32
+#define LD_GUEST_READ_SMALL (64u * 1024u)
+typedef struct { ID3D12Resource* rb; u32 w, h, pitch, ea, dst_pitch; int pooled; } ld_guest_read;
+static ld_guest_read s_guest_reads[LD_GUEST_READS];
+static u32 s_n_guest_reads;
+static ID3D12Resource* s_guest_read_pool[LD_GUEST_READS];
+static u32 s_guest_read_pool_n;
+extern void gcm_guest_row_write(u32 ea, const u8* s, u32 n);
+
+/* After the fence: the list that copied them has finished. Big-endian A8R8G8B8. */
+static SRWLOCK s_guest_read_pool_lock = SRWLOCK_INIT;
+static void ld_guest_read_apply_one(ld_guest_read* r);
+static void ld_guest_reads_apply(void)
+{
+    for (u32 i = 0; i < s_n_guest_reads; i++)
+        ld_guest_read_apply_one(&s_guest_reads[i]);
+    s_n_guest_reads = 0;
+}
+
+/* A present with readbacks pending used to wait for the whole frame on the GPU before the next
+ * one could start: in a GT5 race that was nearly every frame, 6-8 ms each. Now its readbacks go
+ * to this thread, which applies them as soon as the GPU is past them, and the present overlaps
+ * like any other. They still land in guest memory in order; a full wait drains this first.
+ * LD_ASYNC_READBACK=0 restores applying them only after a full wait. */
+#define LD_READ_BATCHES 8
+typedef struct { u64 fence; u32 n; ld_guest_read r[LD_GUEST_READS]; } ld_read_batch;
+static ld_read_batch s_rb_q[LD_READ_BATCHES];
+static volatile LONG s_rb_head, s_rb_tail;
+static HANDLE s_rb_wake, s_rb_fence_evt;
+static int ld_async_readback(void)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("LD_ASYNC_READBACK"); on = !e || atoi(e) != 0; }
+    return on;
+}
+static DWORD WINAPI ld_read_worker(LPVOID unused)
+{
+    (void)unused;
+    for (;;) {
+        WaitForSingleObject(s_rb_wake, INFINITE);
+        while (InterlockedCompareExchange(&s_rb_head, 0, 0) != InterlockedCompareExchange(&s_rb_tail, 0, 0)) {
+            ld_read_batch* bt = &s_rb_q[(u32)s_rb_head % LD_READ_BATCHES];
+            if (g.fence->lpVtbl->GetCompletedValue(g.fence) < bt->fence &&
+                SUCCEEDED(g.fence->lpVtbl->SetEventOnCompletion(g.fence, bt->fence, s_rb_fence_evt)))
+                WaitForSingleObject(s_rb_fence_evt, INFINITE);
+            for (u32 i = 0; i < bt->n; i++) ld_guest_read_apply_one(&bt->r[i]);
+            InterlockedIncrement(&s_rb_head);
+        }
+    }
+}
+/* Room for one more batch, starting the thread the first time. */
+static int ld_read_batch_room(void)
+{
+    if (!ld_async_readback()) return 0;
+    if (!s_rb_wake) {
+        s_rb_wake = CreateEventA(NULL, FALSE, FALSE, NULL);
+        s_rb_fence_evt = CreateEventA(NULL, FALSE, FALSE, NULL);
+        HANDLE t = (s_rb_wake && s_rb_fence_evt) ? CreateThread(NULL, 0, ld_read_worker, NULL, 0, NULL) : NULL;
+        if (!t) return 0;
+        CloseHandle(t);
+    }
+    return (u32)(InterlockedCompareExchange(&s_rb_tail, 0, 0) - InterlockedCompareExchange(&s_rb_head, 0, 0)) < LD_READ_BATCHES;
+}
+static void ld_read_batch_push(u64 fence)
+{
+    ld_read_batch* bt = &s_rb_q[(u32)s_rb_tail % LD_READ_BATCHES];
+    bt->fence = fence;
+    bt->n = s_n_guest_reads;
+    memcpy(bt->r, s_guest_reads, sizeof(s_guest_reads[0]) * s_n_guest_reads);
+    s_n_guest_reads = 0;
+    InterlockedIncrement(&s_rb_tail);
+    SetEvent(s_rb_wake);
+}
+/* Before anything newer is applied here, everything queued has landed. */
+static void ld_read_batches_drain(void)
+{
+    if (!s_rb_wake) return;
+    while (InterlockedCompareExchange(&s_rb_head, 0, 0) != InterlockedCompareExchange(&s_rb_tail, 0, 0)) {
+        SetEvent(s_rb_wake);
+        SwitchToThread();
+    }
+}
+
+static void ld_guest_read_apply_one(ld_guest_read* r)
+{
+    {
+        const SIZE_T size = (SIZE_T)r->pitch * r->h;
+        u8* px = NULL; D3D12_RANGE rr = {0, size};
+        u8* row = (u8*)malloc((size_t)r->w * 4u);
+        if (row && SUCCEEDED(r->rb->lpVtbl->Map(r->rb, 0, &rr, (void**)&px))) {
+            for (u32 y = 0; y < r->h; y++) {
+                const u8* in = px + (SIZE_T)y * r->pitch;
+                for (u32 x = 0; x < r->w; x++) {
+                    row[x * 4u + 0u] = in[x * 4u + 3u];
+                    row[x * 4u + 1u] = in[x * 4u + 0u];
+                    row[x * 4u + 2u] = in[x * 4u + 1u];
+                    row[x * 4u + 3u] = in[x * 4u + 2u];
+                }
+                gcm_guest_row_write(r->ea + y * r->dst_pitch, row, r->w * 4u);
+            }
+            D3D12_RANGE wr = {0, 0};
+            r->rb->lpVtbl->Unmap(r->rb, 0, &wr);
+        }
+        free(row);
+        AcquireSRWLockExclusive(&s_guest_read_pool_lock);
+        const int keep = r->pooled && s_guest_read_pool_n < LD_GUEST_READS;
+        if (keep) s_guest_read_pool[s_guest_read_pool_n++] = r->rb;
+        ReleaseSRWLockExclusive(&s_guest_read_pool_lock);
+        if (!keep) r->rb->lpVtbl->Release(r->rb);
+    }
+}
+
+/* Let a present overlap the next frame. Waiting for the GPU to finish at every present held the
+ * RSX thread 7-10 ms of a 35 ms race frame with the GPU 40% busy, and the title's frame waits on
+ * that thread. So a present submits, waits only for the frame before it, and the CPU records the
+ * next frame while the GPU draws this one. Everything a reset would overwrite stays in use until a
+ * full wait: the transient rings keep running forward, and a present that finds one past half
+ * full waits properly and starts them again, as does one with a readback pending. Every other
+ * flush still waits for everything. LD_PRESENT_OVERLAP=0 restores a full wait at every present. */
+static unsigned long long g_ld_full_waits, g_ld_fence_wait_us;
+static void ld_alloc_report(void)
+{
+    static int on = -1; static LONGLONG last;
+    if (on < 0) on = getenv("LD_ALLOC_TRACE") ? 1 : 0;
+    if (!on) return;
+    LARGE_INTEGER t, f; QueryPerformanceCounter(&t); QueryPerformanceFrequency(&f);
+    if (t.QuadPart - last < 5 * f.QuadPart) return;
+    last = t.QuadPart;
+    fprintf(stderr, "[alloc]");
+    for (u32 i = 0; i < LD_ALLOC_SITES; i++)
+        if (g_ld_alloc_at[i]) { fprintf(stderr, " L%u=%u", i, g_ld_alloc_at[i]); g_ld_alloc_at[i] = 0; }
+    fprintf(stderr, "\n");
+}
+
+unsigned g_ld_ovl_why_pub[8];
+#define g_ld_ovl_why g_ld_ovl_why_pub
+static int ld_present_overlap(void)
+{
+    static int on = -1;
+    if (on < 0) {
+        const char* e = getenv("LD_PRESENT_OVERLAP");
+        on = (!e || atoi(e) != 0) && !getenv("LD_GPU_TIME") && g.alloc2;
+    }
+    if (!on) return 0;
+    /* Which ring kept a present from overlapping, counted for the [present-parts] line. */
+    const int why[9] = { s_n_guest_reads != 0 && !ld_read_batch_room(), g.upload_used >= UPLOAD_SIZE / 2,
+        g.vb_used >= VERT_BUFFER_SIZE / 2, g.ib_used >= INDEX_BUFFER_SIZE / 2,
+        g.cb_used >= CB_RING_BYTES / 2, g.ps_cb_used >= PS_CB_RING_BYTES / 2,
+        g.srv_ring_used >= SRV_RING_TABLES / 2,
+        /* Sampler tables are written once and only ever reused by content, so a full ring just
+         * means the next new one flushes (sampler_table_needs_flush). They no longer reset at
+         * every present, and so never keep one from overlapping. */
+        0, 0 };
+    int any = 0;
+    for (int i = 0; i < 8; i++) if (why[i]) { g_ld_ovl_why[i]++; any = 1; }
+    return !any;
+}
+
+static void ld_hitch_note(LONGLONG now)
+{
+    static int ms = -1; static LONGLONG last; static unsigned long long fw0; static unsigned shown;
+    if (ms < 0) { const char* e = getenv("LD_HITCH_MS"); ms = e ? atoi(e) : 250; }
+    LARGE_INTEGER f; QueryPerformanceFrequency(&f);
+    const double k = 1000.0 / (double)f.QuadPart;
+    const double gap = last ? (double)(now - last) * k : 0.0;
+    if (ms > 0 && last && gap >= ms && shown < 400) {
+        shown++;
+        const double known = (g_hx_pso + g_hx_tex + g_hx_res) * k;
+        fprintf(stderr, "[slow-frame] %.0f ms at frame %u: new pipelines %u in %.0f ms (driver %.0f, shader cache reads %u in %.0f), "
+                "texture decodes %u in %.0f ms, texture hashing %.0f ms, new GPU resources %u in %.0f ms, GPU wait %.0f ms, rest %.0f ms\n",
+                gap, g_ld_frames, g_hx_pso_n, g_hx_pso * k, g_hx_create * k, g_hx_cache_n, g_hx_cache * k,
+                g_hx_tex_n, g_hx_tex * k, g_hx_hash * k, g_hx_res_n, g_hx_res * k,
+                (double)(g_ld_fence_wait_us - fw0) / 1000.0, gap - known - (double)(g_ld_fence_wait_us - fw0) / 1000.0);
+    }
+    g_hx_pso = g_hx_create = g_hx_tex = g_hx_hash = g_hx_res = g_hx_cache = 0;
+    g_hx_pso_n = g_hx_tex_n = g_hx_res_n = g_hx_cache_n = 0;
+    fw0 = g_ld_fence_wait_us;
+    last = now;
+}
+
+/* ===========================================================================
+ * A second thread records the D3D12 command list (LD_RECORD_THREAD=0 turns it off).
+ *
+ * The FIFO walk is on GT5's critical path (each label it writes is something the
+ * game may be waiting for), and about a fifth of it was the D3D12 runtime and the
+ * driver recording calls: some 6000 a frame in a race. Here g.list is a stand-in
+ * whose methods copy their arguments into a ring, and this thread replays them
+ * onto the real list. Everything that reads guest memory, converts data, picks
+ * pipelines and writes labels stays on the walker; only the recording moves.
+ *
+ * Ordering: Close and Reset on the stand-in wait until the ring is empty, so
+ * submission, fences and the present are exactly as before. The one thing a
+ * recorded call reads at record time rather than on the GPU is a CPU descriptor
+ * (OMSetRenderTargets, the clears), so creating an RTV or DSV waits for the ring
+ * first (ld_rec_sync). Resource lifetimes need nothing new: anything a queued
+ * call names already has to live until the GPU has run it, which is later. */
+static ID3D12GraphicsCommandList* s_rec_real;
+static int s_rec_on;
+#define LD_REC_RING (32u << 20)
+static u8* s_rec_ring;
+static volatile LONG64 s_rec_wr, s_rec_rd;    /* published write / executed positions */
+static u64 s_rec_wloc;                        /* the walker's own write position */
+static volatile LONG s_rec_sleeping;
+static HANDLE s_rec_wake;
+unsigned long long g_rec_ops, g_rec_sync_qpc;
+typedef struct { u32 op, bytes; } ld_rec_hdr;
+enum { RO_WRAP = 1, RO_BARRIER, RO_COPYTEX, RO_GRT, RO_CRT, RO_CLRDSV, RO_DRAW, RO_CLRRTV, RO_GCBV,
+       RO_G32, RO_CRS, RO_DISPATCH, RO_COPYRES, RO_PSO, RO_GRS, RO_HEAPS, RO_VP, RO_SC, RO_STENCIL,
+       RO_RTS, RO_VB, RO_TOPO, RO_IB, RO_DRAWIDX, RO_ENDQ, RO_RESOLVEQ };
+static ID3D12GraphicsCommandList* ld_list_real(void) { return s_rec_on ? s_rec_real : g.list; }
+
+static u8* ld_rec_begin(u32 op, size_t payload)
+{
+    const u32 bytes = (u32)((sizeof(ld_rec_hdr) + payload + 15u) & ~(size_t)15u);
+    u64 pos = s_rec_wloc % LD_REC_RING;
+    const u64 tail = LD_REC_RING - pos;
+    const u64 need = bytes + (tail < bytes ? tail : 0);
+    unsigned n = 0;
+    while (s_rec_wloc + need - (u64)InterlockedCompareExchange64(&s_rec_rd, 0, 0) > LD_REC_RING) {
+        if (s_rec_sleeping) SetEvent(s_rec_wake);
+        if (++n & 63) YieldProcessor(); else SwitchToThread();
+    }
+    if (tail < bytes) {
+        ld_rec_hdr* w = (ld_rec_hdr*)(s_rec_ring + pos);
+        w->op = RO_WRAP; w->bytes = (u32)tail;
+        s_rec_wloc += tail; pos = 0;
+    }
+    ld_rec_hdr* h = (ld_rec_hdr*)(s_rec_ring + pos);
+    h->op = op; h->bytes = bytes;
+    s_rec_wloc += bytes;
+    return (u8*)(h + 1);
+}
+static void ld_rec_end(void)
+{
+    InterlockedExchange64(&s_rec_wr, (LONG64)s_rec_wloc);
+    g_rec_ops++;
+    if (s_rec_sleeping) SetEvent(s_rec_wake);
+}
+/* Wait until the recording thread has replayed everything queued. */
+static void ld_rec_sync(void)
+{
+    if (!s_rec_on) return;
+    if ((u64)InterlockedCompareExchange64(&s_rec_rd, 0, 0) == s_rec_wloc) return;
+    LARGE_INTEGER t0, t1; QueryPerformanceCounter(&t0);
+    unsigned n = 0;
+    while ((u64)InterlockedCompareExchange64(&s_rec_rd, 0, 0) != s_rec_wloc) {
+        if (s_rec_sleeping) SetEvent(s_rec_wake);
+        if (++n & 63) YieldProcessor(); else SwitchToThread();
+    }
+    QueryPerformanceCounter(&t1);
+    g_rec_sync_qpc += (unsigned long long)(t1.QuadPart - t0.QuadPart);
+}
