+static struct { const ID3D12GraphicsCommandListVtbl* lpVtbl; } s_rec_proxy;
+static ID3D12GraphicsCommandListVtbl s_rec_vtbl;
+/* Put the stand-in in front of g.list. On by default; LD_RECORD_THREAD=0 records on the walker
+ * as before. Measured in a GT5 race: the walk 6-9% shorter per draw, barriers and copies
+ * 2.0 -> 1.5 ms a frame, the walker waiting 0.04 ms a frame for this thread. */
+static void ld_rec_install(void)
+{
+    const char* e = getenv("LD_RECORD_THREAD");
+    if ((e && atoi(e) == 0) || !g.list || s_rec_on) return;
+    s_rec_ring = (u8*)VirtualAlloc(NULL, LD_REC_RING, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+    s_rec_wake = CreateEventA(NULL, FALSE, FALSE, NULL);
+    if (!s_rec_ring || !s_rec_wake) return;
+    void** slots = (void**)&s_rec_vtbl;
+    for (size_t i = 0; i < sizeof s_rec_vtbl / sizeof(void*); i++) slots[i] = (void*)pr_trap;
+    s_rec_vtbl.QueryInterface = pr_QueryInterface; s_rec_vtbl.AddRef = pr_AddRef; s_rec_vtbl.Release = pr_Release;
+    s_rec_vtbl.SetName = pr_SetName; s_rec_vtbl.GetType = pr_GetType;
+    s_rec_vtbl.Close = pr_Close; s_rec_vtbl.Reset = pr_Reset;
+    s_rec_vtbl.ResourceBarrier = pr_ResourceBarrier; s_rec_vtbl.CopyTextureRegion = pr_CopyTextureRegion;
+    s_rec_vtbl.SetGraphicsRootDescriptorTable = pr_SetGraphicsRootDescriptorTable;
+    s_rec_vtbl.SetComputeRootDescriptorTable = pr_SetComputeRootDescriptorTable;
+    s_rec_vtbl.ClearDepthStencilView = pr_ClearDepthStencilView; s_rec_vtbl.ClearRenderTargetView = pr_ClearRenderTargetView;
+    s_rec_vtbl.DrawInstanced = pr_DrawInstanced; s_rec_vtbl.DrawIndexedInstanced = pr_DrawIndexedInstanced;
+    s_rec_vtbl.SetGraphicsRootConstantBufferView = pr_SetGraphicsRootConstantBufferView;
+    s_rec_vtbl.SetGraphicsRoot32BitConstants = pr_SetGraphicsRoot32BitConstants;
+    s_rec_vtbl.SetComputeRootSignature = pr_SetComputeRootSignature; s_rec_vtbl.SetGraphicsRootSignature = pr_SetGraphicsRootSignature;
+    s_rec_vtbl.SetPipelineState = pr_SetPipelineState; s_rec_vtbl.Dispatch = pr_Dispatch; s_rec_vtbl.CopyResource = pr_CopyResource;
+    s_rec_vtbl.SetDescriptorHeaps = pr_SetDescriptorHeaps; s_rec_vtbl.RSSetViewports = pr_RSSetViewports;
+    s_rec_vtbl.RSSetScissorRects = pr_RSSetScissorRects; s_rec_vtbl.OMSetStencilRef = pr_OMSetStencilRef;
+    s_rec_vtbl.OMSetRenderTargets = pr_OMSetRenderTargets; s_rec_vtbl.IASetVertexBuffers = pr_IASetVertexBuffers;
+    s_rec_vtbl.IASetPrimitiveTopology = pr_IASetPrimitiveTopology; s_rec_vtbl.IASetIndexBuffer = pr_IASetIndexBuffer;
+    s_rec_vtbl.EndQuery = pr_EndQuery; s_rec_vtbl.ResolveQueryData = pr_ResolveQueryData;
+    s_rec_proxy.lpVtbl = &s_rec_vtbl;
+    HANDLE t = CreateThread(NULL, 1u << 20, ld_rec_worker, NULL, 0, NULL);
+    if (!t) return;
+    SetThreadPriority(t, THREAD_PRIORITY_ABOVE_NORMAL);
+    CloseHandle(t);
+    s_rec_real = g.list;
+    g.list = (ID3D12GraphicsCommandList*)&s_rec_proxy;
+    s_rec_on = 1;
+    fprintf(stderr, "[ld-rec] D3D12 commands are recorded on their own thread (LD_RECORD_THREAD)\n");
+}
