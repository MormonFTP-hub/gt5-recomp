+        if (!f->desc.type || !f->desc.size) continue;          /* its default is in the key */
+        if (!f->stable_base || f->stable_last < f->stable_first) { ld_vc_fail(1, f->stable_base); return 0; }
+        lo[n] = f->stable_base;
+        hi[n] = f->stable_base + (u64)(f->stable_last - f->stable_first) * f->stride + f->elem_size;
+        n++;
+    }
+    if (!n) { ld_vc_fail(2, NULL); return 0; }
+    for (u32 i = 0; i < n; i++) {
+        lo[i] = (const u8*)((uintptr_t)lo[i] & ~(uintptr_t)4095);
+        hi[i] = (const u8*)(((uintptr_t)hi[i] + 4095) & ~(uintptr_t)4095);
+    }
+    for (u32 i = 1; i < n; i++)                                 /* insertion sort by start */
+        for (u32 j = i; j > 0 && lo[j] < lo[j - 1]; j--) {
+            const u8* t = lo[j]; lo[j] = lo[j - 1]; lo[j - 1] = t;
+            t = hi[j]; hi[j] = hi[j - 1]; hi[j - 1] = t;
+        }
