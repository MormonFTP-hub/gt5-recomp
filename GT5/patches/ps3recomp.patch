+/* Windows keeps one written-or-not bit per page, and many draws share a page (GT5's SPU jobs
+ * pack dozens of small vertex chunks into one): an entry that reset a page's bit hid the write
+ * that had changed its neighbour's data. So the bits are harvested into a generation per guest
+ * page instead -- each harvest takes the written pages and resets them, and stamps them with a
+ * new generation -- and an entry is clean while none of its pages is newer than its own. */
+#define LD_VC_SPAN_PAGES 2048u                 /* 8 MB: the largest span tracked */
+static u32* s_vc_page_gen;                     /* one per 4 KB of the 4 GB guest space */
+static u32 s_vc_gen = 1;
+static void* s_vc_addr[LD_VC_SPAN_PAGES];
+static int ld_vc_harvest(const u8* lo, const u8* hi)
+{
+    if (!s_vc_page_gen) {
+        s_vc_page_gen = (u32*)calloc(1u << 20, sizeof(u32));
+        if (!s_vc_page_gen) return 0;
+    }
+    if ((u64)(hi - lo) > (u64)LD_VC_SPAN_PAGES * 4096u || lo < vm_base || hi > vm_base + 0x100000000ull) return 0;
+    ULONG_PTR n = LD_VC_SPAN_PAGES; ULONG gran = 0;
+    static int noreset = -1;   /* LD_VCACHE_NORESET=1: query without resetting (debug; nothing ever reads clean) */
+    if (noreset < 0) noreset = getenv("LD_VCACHE_NORESET") ? 1 : 0;
+    if (GetWriteWatch(noreset ? 0 : WRITE_WATCH_FLAG_RESET, (void*)lo, (SIZE_T)(hi - lo), s_vc_addr, &n, &gran) != 0) return 0;
+    if (n) {
+        const u32 gen = ++s_vc_gen;
+        for (ULONG_PTR i = 0; i < n; i++)
+            s_vc_page_gen[(u32)(((const u8*)s_vc_addr[i] - vm_base) >> 12)] = gen;
+    }
+    return 1;
+}
