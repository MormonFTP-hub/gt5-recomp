+def test_offset_table_constant_base():
+    """An offset table whose base is built from immediates, not loaded via r2.
+
+        cmplwi cr7,r4,2 ; lis r9,1 ; slwi r11,r4,2 ; addi r9,r9,0x400 ;
+        lwzx r0,r11,r9 ; extsw r0,r0 ; add r0,r0,r9 ; mtctr r0 ; bctr
+
+    GT5's update 2.17 (a newer compiler than its disc) builds every switch base
+    this way (`lis r9,0xB3; addi r9,r9,0x98C`). Only TOC-loaded bases were
+    accepted, so each one lifted to an unresolved indirect call.
+    """
+    table = 0x10400
+    mem = {table + 0: 0x100, table + 4: 0x200, table + 8: 0x300,
+           table + 12: 0xFFFFFFFF}                   # misaligned target: the table ends
+    w_addi = lambda rt, ra, si: (14 << 26) | (rt << 21) | (ra << 16) | (si & 0xFFFF)
+    w_extsw = lambda ra, rs: (31 << 26) | (rs << 21) | (ra << 16) | (986 << 1)
+    got = discover([w_cmplwi(7, 4, 2), w_addis(9, 0, 1), w_slwi(11, 4, 2),
+                    w_addi(9, 9, 0x400), w_lwzx(0, 11, 9), w_extsw(0, 0),
+                    w_add(0, 0, 9), w_mtctr(0), w_bctr()], mem)
+    check("offset table with a lis/addi constant base", got, [0x10500, 0x10600, 0x10700])
+
+
+def test_index_register_reused_for_entry():
+    """`lwzx r0, r9, r0`: the shifted index and the loaded entry share r0.
+
+        cmplwi cr7,r8,299 ; lis r9,1 ; addi r9,r9,0x400 ; slwi r0,r8,2 ;
+        lwzx r0,r9,r0 ; extsw r0,r0 ; add r0,r0,r9 ; mtctr r0 ; bctr
+
+    The raw-index search took `add r0,r0,r9` (AFTER the load) as r0's definition,
+    never reached the shift, missed the bound compare on r8 and capped the table
+    at 256 entries. GT5 2.17's 310-case func_00B7288C lost its last cases.
+    """
+    table = 0x10400
+    n = 300
+    mem = {table + 4 * k: 0x1000 + 4 * k for k in range(n)}
+    mem[table + 4 * n] = 0xFFFFFFFF                  # misaligned target: the table ends
+    w_addi = lambda rt, ra, si: (14 << 26) | (rt << 21) | (ra << 16) | (si & 0xFFFF)
+    w_extsw = lambda ra, rs: (31 << 26) | (rs << 21) | (ra << 16) | (986 << 1)
+    got = discover([w_cmplwi(7, 8, n - 1), w_addis(9, 0, 1), w_addi(9, 9, 0x400),
+                    w_slwi(0, 8, 2), w_lwzx(0, 9, 0), w_extsw(0, 0),
+                    w_add(0, 0, 9), w_mtctr(0), w_bctr()], mem)
+    check("index register reused for the entry: bound past 256 kept",
+          None if got is None else len(got), n)
+
