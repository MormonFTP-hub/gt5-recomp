diff --git a/include/ps3emu/thread_name.h b/include/ps3emu/thread_name.h
index da9c5928..692debc8 100644
--- a/include/ps3emu/thread_name.h
+++ b/include/ps3emu/thread_name.h
@@ -43,4 +43,48 @@ static inline void ps3_thread_name(const char* fmt, ...)
 static inline void ps3_thread_name(const char* fmt, ...) { (void)fmt; }
 #endif
 
+/* ps3_thread_on_fast_cores: for a host thread with a real-time deadline (audio). On a CPU with
+ * performance and efficiency cores, Windows puts a busy thread of a background window on an
+ * efficiency core, at about half the speed, and an audio job that fits in its 5.33 ms on one
+ * does not fit on the other. Keeps the thread on the fastest class of core and out of EcoQoS.
+ * The calls are looked up at run time; where they are missing, or all cores are alike, it only
+ * raises the priority. */
+#ifdef _WIN32
+static inline void ps3_thread_on_fast_cores(void)
+{
+    typedef BOOL (WINAPI *get_sets_fn)(void*, ULONG, PULONG, HANDLE, ULONG);
+    typedef BOOL (WINAPI *set_sets_fn)(HANDLE, const ULONG*, ULONG);
+    typedef BOOL (WINAPI *set_info_fn)(HANDLE, int, void*, DWORD);
+    HMODULE k = GetModuleHandleA("kernel32.dll");
+    get_sets_fn get_sets = (get_sets_fn)(void*)GetProcAddress(k, "GetSystemCpuSetInformation");
+    set_sets_fn set_sets = (set_sets_fn)(void*)GetProcAddress(k, "SetThreadSelectedCpuSets");
+    set_info_fn set_info = (set_info_fn)(void*)GetProcAddress(k, "SetThreadInformation");
+    SetThreadPriority(GetCurrentThread(), THREAD_PRIORITY_ABOVE_NORMAL);
+    if (set_info) {
+        struct { ULONG version, control, state; } off = { 1, 1 /* execution speed */, 0 };
+        set_info(GetCurrentThread(), 3 /* ThreadPowerThrottling */, &off, sizeof off);
+    }
+    if (!get_sets || !set_sets) return;
+    static unsigned char buf[32768];   /* filled once; a duplicate fill writes the same bytes */
+    ULONG len = 0;
+    if (!get_sets(buf, sizeof buf, &len, GetCurrentProcess(), 0)) return;
+    int best = -1, worst = 256;
+    ULONG ids[256], n = 0;
+    for (ULONG o = 0; o < len; ) {
+        const SYSTEM_CPU_SET_INFORMATION* c = (const SYSTEM_CPU_SET_INFORMATION*)(buf + o);
+        if (c->Size == 0) break;
+        if (c->Type == CpuSetInformation) {
+            const int e = c->CpuSet.EfficiencyClass;
+            if (e < worst) worst = e;
+            if (e > best) { best = e; n = 0; }
+            if (e == best && n < 256) ids[n++] = c->CpuSet.Id;
+        }
+        o += c->Size;
+    }
+    if (n && best != worst) set_sets(GetCurrentThread(), ids, n);
+}
+#else
+static inline void ps3_thread_on_fast_cores(void) {}
+#endif
+
 #endif /* PS3EMU_THREAD_NAME_H */
