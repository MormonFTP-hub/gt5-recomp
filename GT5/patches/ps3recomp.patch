+static void pad_poll_dualsense(void)
+{
+    static int started = 0;
+    if (!started) {
+        started = 1;
+        if (!getenv("PAD_NO_DUALSENSE")) {
+            HANDLE t = CreateThread(NULL, 64 * 1024, ds_thread, NULL, 0, NULL);
+            if (t) CloseHandle(t);
+        }
+    }
+    /* PAD_DS_REPORT_FILE=<file>: a test's DualSense, one input report as hex, through the same
+     * parser as the real one, with no window focus needed. */
+    { static const char* sim = (const char*)-1;
+      if (sim == (const char*)-1) sim = getenv("PAD_DS_REPORT_FILE");
+      if (sim) {
+          FILE* f = fopen(sim, "r");
+          if (f) {
+              u8 rep[128]; memset(rep, 0, sizeof rep);
+              unsigned v; int i = 0;
+              while (i < 128 && fscanf(f, "%2x", &v) == 1) rep[i++] = (u8)v;
+              fclose(f);
+              if (i >= 11) ds_parse(rep, (DWORD)i, 1);
+          }
+          AcquireSRWLockShared(&s_ds_lock);
+          s_host_state[0] = s_ds_state;
+          ReleaseSRWLockShared(&s_ds_lock);
+          return;
+      } }
+    { static int tr = -1, was = -1;
+      if (tr < 0) tr = getenv("PAD_TRACE") ? 1 : 0;
+      const int f = pad_host_window_focused();
+      if (tr && f != was) {
+          /* Title, window class and program: an untitled window took focus in a user's session and
+           * the title alone could not say whose it was. */
+          char title[80] = "", cls[64] = "", exe[MAX_PATH] = "";
+          HWND fg = GetForegroundWindow();
+          if (fg) {
+              GetWindowTextA(fg, title, sizeof title);
+              GetClassNameA(fg, cls, sizeof cls);
+              DWORD pid = 0; GetWindowThreadProcessId(fg, &pid);
+              HANDLE ph = pid ? OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid) : NULL;
+              if (ph) { DWORD len = sizeof exe; QueryFullProcessImageNameA(ph, 0, exe, &len); CloseHandle(ph); }
+          }
+          const char* base = strrchr(exe, '\\');
+          fprintf(stderr, "[pad] t=%llu window %s, foreground now '%s' class '%s' program '%s'\n", pad_now_ms(),
+                  f ? "focused" : "LOST FOCUS", title, cls, base ? base + 1 : exe);
+      }
+      was = f; }
+    /* PAD_BACKGROUND=1 (play.bat): the pad keeps driving the game while another window has focus.
+     * A focus grab by something untitled left the pad dead for the rest of a race. Test runs leave
+     * it off, so the user's controller never reaches a game running behind their windows. */
+    static int bg = -1;
+    if (bg < 0) bg = getenv("PAD_BACKGROUND") ? 1 : 0;
+    const int focused = pad_host_window_focused();
+    if (!InterlockedCompareExchange(&s_ds_live, 0, 0) || (!focused && !bg)) {
+        pad_cursor_guard(NULL);
+        return;
+    }
+    /* The controller alone. Steam's desktop mode, among others, turns pad buttons into keys while
+     * it runs, so merging the keyboard made Cross also press Enter, which is Start here. */
+    AcquireSRWLockShared(&s_ds_lock);
+    s_host_state[0] = s_ds_state;
+    ReleaseSRWLockShared(&s_ds_lock);
+    pad_cursor_guard(focused ? &s_host_state[0] : NULL);   /* never clip the cursor over someone else's window */
+}
