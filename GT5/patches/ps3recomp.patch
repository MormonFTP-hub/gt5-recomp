+/* What to do with this draw: 0 the ordinary path, 1 ordinary path then record its pages,
+ * 2 ordinary conversion stored into the arena, 3 drawn from the arena. */
+static int ld_vc_find(u32 prim, const rsx_vertex_layout_plan* layout, ld_vc_entry** out)
+{
+    *out = NULL;
+    if (!ld_vc_enabled()) return 0;
+    ld_vc_key k;
+    if (!ld_vc_key_build(&k, prim, layout)) { g_vc_stat[5]++; return 0; }
+    const u64 h = ld_fast_hash(&k, (u32)sizeof k, 0x51ED270B27D4EB4Full) | 1u;
+    u32 i = (u32)(h >> 17) & (LD_VC_SLOTS - 1u);
+    ld_vc_entry* empty = NULL;
+    ld_vc_entry* oldest = NULL;
+    for (u32 probe = 0; probe < 32; probe++, i = (i + 1u) & (LD_VC_SLOTS - 1u)) {
+        ld_vc_entry* e = &s_vc[i];
+        if (!e->state) { if (!empty) empty = e; break; }
+        if (!oldest || e->last_frame < oldest->last_frame) oldest = e;
+        if (e->h != h || memcmp(&e->k, &k, sizeof k) != 0) continue;
+        e->last_frame = g_ld_frames;
+        if (e->state == 3) { g_vc_stat[4]++; return 0; }
+        *out = e;
+        if (!e->n_spans) return 1;
+        const int c = ld_vc_clean(e);
+        if (c < 0) { e->state = 3; g_vc_stat[7]++; return 0; }
+        if (c == 0) {
+            g_vc_stat[3]++;
+            if (++e->strikes >= 2) { e->state = 3; *out = NULL; return 0; }
+            e->state = 1; e->n_spans = 0;
+            return 1;
+        }
+        if (e->state == 2) {
+            static int nohit = -1;   /* LD_VCACHE_NOHIT=1: track and store, never draw from the arena (debug) */
+            if (nohit < 0) nohit = getenv("LD_VCACHE_NOHIT") ? 1 : 0;
+            if (nohit) return 0;
+            g_vc_stat[0]++; return 3;
+        }
+        return 2;
+    }
+    /* Not in the table. A draw from a ring buffer has a new address every frame and would fill
+     * the table with keys that never come back, so a key gets a slot only when it is seen a second
+     * time; until then one word per hash bucket remembers it. */
+    static u64 s_vc_seen[1u << 16];
+    u64* seen = &s_vc_seen[(u32)(h >> 7) & 0xFFFFu];
+    if (*seen != h) { *seen = h; g_vc_stat[5]++; return 0; }
+    ld_vc_entry* e = empty ? empty : oldest;   /* crowded: replace the one unused the longest */
+    if (!e) { g_vc_stat[5]++; return 0; }
+    memset(e, 0, sizeof *e);
+    e->h = h; e->k = k; e->state = 1; e->last_frame = g_ld_frames;
+    *out = e;
+    return 1;
+}
