+static DWORD WINAPI ld_rec_worker(LPVOID unused)
+{
+    (void)unused;
+    { HRESULT (WINAPI *sd)(HANDLE, PCWSTR) = (HRESULT (WINAPI*)(HANDLE, PCWSTR))
+          (void*)GetProcAddress(GetModuleHandleA("kernel32.dll"), "SetThreadDescription");
+      if (sd) sd(GetCurrentThread(), L"rsx record"); }
+    u64 rd = 0;
+    for (;;) {
+        u64 wr = (u64)InterlockedCompareExchange64(&s_rec_wr, 0, 0);
+        for (unsigned spins = 0; wr == rd; wr = (u64)InterlockedCompareExchange64(&s_rec_wr, 0, 0)) {
+            if (++spins < 4096) { YieldProcessor(); continue; }
+            InterlockedExchange(&s_rec_sleeping, 1);
+            wr = (u64)InterlockedCompareExchange64(&s_rec_wr, 0, 0);
+            if (wr == rd) WaitForSingleObject(s_rec_wake, 2);
+            InterlockedExchange(&s_rec_sleeping, 0);
+            spins = 0;
+            if (wr != rd) break;
+        }
+        while (rd != wr) {
+            const ld_rec_hdr* h = (const ld_rec_hdr*)(s_rec_ring + rd % LD_REC_RING);
+            ld_rec_exec(h);
+            rd += h->bytes;
+            InterlockedExchange64(&s_rec_rd, (LONG64)rd);
+        }
+    }
+}
