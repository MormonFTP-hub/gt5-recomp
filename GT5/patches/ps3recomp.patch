+static DWORD WINAPI ds_thread(LPVOID unused)
+{
+    (void)unused;
+    for (;;) {
+        int dualsense = 0;
+        HANDLE h = ds_open(&dualsense);
+        if (h == INVALID_HANDLE_VALUE) { Sleep(3000); continue; }
+        printf("[cellPad] %s found: reading it directly\n", dualsense ? "DualSense" : "DualShock 4");
+        fflush(stdout);
+        u8 buf[128];
+        DWORD n;
+        while (ReadFile(h, buf, sizeof buf, &n, NULL)) {
+            ds_parse(buf, n, dualsense);
+            InterlockedExchange(&s_ds_live, 1);
+        }
+        InterlockedExchange(&s_ds_live, 0);
+        CloseHandle(h);
+    }
+    return 0;
