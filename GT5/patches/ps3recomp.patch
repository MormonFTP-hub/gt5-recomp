+/* Which GPU draws. A NULL adapter is whatever DXGI lists first: on a laptop with two GPUs that is
+ * usually the integrated one the screen is wired to, which made races crawl on gaming laptops. Ask for
+ * the high-performance GPU instead (IDXGIFactory6, Windows 10 1803 and newer). PS3_GPU=low picks the
+ * power-saving one, PS3_GPU=<n> the n-th adapter DXGI lists. The choice goes to play.err, and the
+ * exports below ask the NVIDIA and AMD drivers for the fast GPU as well. */
+__declspec(dllexport) unsigned long NvOptimusEnablement = 1;
+__declspec(dllexport) int AmdPowerXpressRequestHighPerformance = 1;
+char g_ld_gpu_name[128];
+
+static int ld_try_adapter(IDXGIAdapter1* ad)
+{
+    DXGI_ADAPTER_DESC1 d;
+    if (FAILED(ad->lpVtbl->GetDesc1(ad, &d)) || (d.Flags & DXGI_ADAPTER_FLAG_SOFTWARE)) return 0;
+    if (FAILED(D3D12CreateDevice((IUnknown*)ad, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&g.dev))) return 0;
+    WideCharToMultiByte(CP_UTF8, 0, d.Description, -1, g_ld_gpu_name, (int)sizeof(g_ld_gpu_name), NULL, NULL);
+    fprintf(stderr, "[gpu] %s, %llu MB of its own memory\n", g_ld_gpu_name,
+            (unsigned long long)(d.DedicatedVideoMemory >> 20));
+    return 1;
+}
+
+static int ld_create_device(IDXGIFactory4* factory)
+{
+    const char* want = getenv("PS3_GPU");
+    IDXGIAdapter1* ad = NULL;
+    if (want && want[0] >= '0' && want[0] <= '9') {
+        if (SUCCEEDED(factory->lpVtbl->EnumAdapters1(factory, (UINT)atoi(want), &ad))) {
+            const int ok = ld_try_adapter(ad);
+            ad->lpVtbl->Release(ad);
+            if (ok) return 0;
+        }
+        fprintf(stderr, "[gpu] PS3_GPU=%s: no such adapter, picking one as usual\n", want);
+    }
+    IDXGIFactory6* f6 = NULL;
+    if (SUCCEEDED(factory->lpVtbl->QueryInterface(factory, &IID_IDXGIFactory6, (void**)&f6))) {
+        const DXGI_GPU_PREFERENCE pref = (want && (!_stricmp(want, "low") || !_stricmp(want, "integrated")))
+            ? DXGI_GPU_PREFERENCE_MINIMUM_POWER : DXGI_GPU_PREFERENCE_HIGH_PERFORMANCE;
+        for (UINT i = 0; !g.dev && f6->lpVtbl->EnumAdapterByGpuPreference(f6, i, pref, &IID_IDXGIAdapter1,
+                                                                          (void**)&ad) != DXGI_ERROR_NOT_FOUND; i++) {
+            ld_try_adapter(ad);
+            ad->lpVtbl->Release(ad);
+        }
+        f6->lpVtbl->Release(f6);
+    }
+    if (!g.dev) {
+        if (FAILED(D3D12CreateDevice(NULL, D3D_FEATURE_LEVEL_11_0, &IID_ID3D12Device, (void**)&g.dev))) return -1;
+        fprintf(stderr, "[gpu] the default adapter (Windows didn't say which is the fast one)\n");
+    }
+    return 0;
+}
