+        if (end > first) {
+            if (end > 0x100000000ull || end - first > (16u << 20)) { ld_vc_fail(0, NULL); return 0; }
+            const u8* q = guest_ptr(ia.location, (u32)first, (u32)(end - first));
+            if (!q) { ld_vc_fail(0, NULL); return 0; }
+            lo[n] = q; hi[n] = q + (end - first); n++;
