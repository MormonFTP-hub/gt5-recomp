+        u.d.cbSize = 8;   /* sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W) on x64 */
+        if (!get_detail(devs, &id, &u.d, sizeof u, NULL, NULL)) continue;
+        HANDLE h = CreateFileW(u.d.path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+        if (h == INVALID_HANDLE_VALUE) continue;
